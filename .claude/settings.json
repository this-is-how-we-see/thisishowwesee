{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(npx vercel *)",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/pre-deploy-git-status.sh\"",
            "timeout": 15,
            "statusMessage": "Checking the working tree before deploy"
          },
          {
            "type": "command",
            "if": "Bash(vercel *)",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/pre-deploy-git-status.sh\"",
            "timeout": 15,
            "statusMessage": "Checking the working tree before deploy"
          }
        ]
      }
    ]
  }
}
