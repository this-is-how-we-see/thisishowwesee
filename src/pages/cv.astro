---
import Layout from "../layouts/Layout.astro";

const roles = [
  {
    title: "Senior Product Manager",
    org: "Cellares",
    meta: "South San Francisco, CA · Jun 2022–Present",
    points: [
      "Lead product across four scrum teams and 30+ engineers building the software for the Cell Shuttle, a fully automated cell therapy manufacturing platform: orchestration, scheduling, reagent tracking, and information management.",
      "Defined how three spectral analyzers integrate with an automated quality control platform running standard cell therapy flow panels, and operated them during integration testing.",
      "Specified requirements for integrating a GMP closed cell sorter into the manufacturing process, moving cell selection inside the closed system rather than leaving it a separate open step.",
      "Delivered the traceability and record-keeping that allow the platform to be used for real patient doses under FDA-regulated quality systems.",
      "Demonstrate the Cell Shuttle and Cell Q to customers, work the CAR-TCR Summit booth, and run structured user research with the analysts who operate them.",
    ],
  },
  {
    title: "Senior Product Owner",
    org: "Rosalind Bioinformatics",
    meta: "San Diego, CA · Jan 2022–Jun 2022",
    points: [
      "Led product for a genomics research platform using machine learning to turn sequencing data into evidence pharmaceutical and clinical users could act on.",
      "Took a diagnostic monitoring system to launch with NIH RADx Tech support, alongside a FedRAMP-authorized platform used under emergency authorization to triage patients by diagnosed variant.",
    ],
  },
  {
    title: "Senior Product Owner / Product Manager",
    org: "BD Biosciences / FlowJo",
    meta: "Ashland, OR · Dec 2018–Jan 2022",
    points: [
      "Invented and patented a method for multicolor panel design that models and minimizes spillover spreading, granted as US 11,935,629 and assigned to BD, with family members in the EU, China, and Japan.",
      "Helped develop and test the spectral unmixing in FlowJo, the analysis software cytometrists use to unmix full spectral data.",
      "Gathered requirements for BD Research Cloud face to face with users, application scientists, technical support, and marketing, at the BD booth at CYTO and the American Association of Immunologists annual meeting, and on customer sites.",
      "Built the business cases, financial analyses, and ROI models BD used to decide which software to invest in, including the cloud analysis platform.",
      "Researched licensing structure and pricing with the sales and strategy team, and maintained the competitive assessments behind that positioning.",
    ],
  },
  {
    title: "Core Research Facility Manager / Laboratory Manager",
    org: "University of Florida",
    meta: "Gainesville, FL · Feb 2011–Nov 2018",
    points: [
      "Ran the fee-for-service flow cytometry and cell sorting cores serving many independent research groups. I was fully responsible for service rates and cost structure, and returned a quarterly profit of $10,000–$30,000 while recovering instrument and staff cost.",
      "Operated and maintained conventional and full spectral analyzers and cell sorters including a Cytek Aurora, and handled the troubleshooting and quality control that kept them running.",
      "Created and led training courses in flow cytometry, advanced multicolor panel design, and instrument operation, mentoring hundreds of researchers and staff.",
      "Supported cell sorting programs tied to cord blood regulatory T-cell work that drew approximately $800,000 in industry sponsorship.",
      "Authored the cGMP protocol for isolating cryopreserved cord-blood regulatory T cells for autologous infusion, achieved cGMP certification, and managed IRB and IACUC protocols.",
    ],
  },
];

const patents = [
  {
    year: "2024",
    body: "<strong>US 11,935,629</strong> &middot; First-named inventor, assigned to BD. Methods for flow cytometry panel design based on modeling and minimizing spillover spreading.",
  },
  {
    year: "2021",
    body: "<strong>US 11,022,615</strong> &middot; Assigned to the University of Florida Research Foundation. Regulatory T-cells, methods for their isolation and uses.",
  },
];

const education = [
  { year: "2016", body: "Specialization Certificate, <strong>Data Science</strong> &middot; Johns Hopkins University / Coursera" },
  { year: "2015", body: "M.Sc., <strong>Biomedical Informatics</strong> &middot; Nova Southeastern University" },
  { year: "2005", body: "B.S., <strong>Zoology</strong> &middot; University of Florida" },
];

const certs = [
  { year: "2021", body: "Certified Scrum Product Owner, Agile Learning Labs" },
  { year: "2019", body: "Comprehensive Course in Flow Cytometry, University of California, Davis" },
  { year: "2018", body: "AWS Certified Cloud Practitioner" },
  { year: "2016", body: "Specialist in Cytometry [SCYM(ASCP)<sup>CM</sup>], International Cytometry Certification Examination" },
  { year: "2015", body: 'Core Concepts in Biomanufacturing and Quality Systems: Application of cGMPs, Biotility' },
  { year: "2012", body: "AAI Introductory Immunology Course, University of Pennsylvania" },
  { year: "2011", body: "FACSAria&trade; III Operator Course, BD Biosciences" },
  { year: "2007", body: "Laboratory Animal Technologist (LATg), AALAS" },
];

const honors = [
  { year: "2021", body: "Wesley J. Howe Award for Science &amp; Technology (Innovation) &middot; BD" },
  { year: "2018", body: 'Spirit of <a href="https://www.jdrfnpod.org/" target="_blank" rel="noopener noreferrer">nPOD</a> Award' },
  { year: "2015", body: '<a href="https://fluorofinder.com/" target="_blank" rel="noopener noreferrer">FluoroFinder</a>&rsquo;s First Featured Core Manager' },
  { year: "2014", body: "University of Florida Superior Accomplishment Award, Division Level" },
  { year: "2004", body: "University Scholar, University of Florida&rsquo;s Undergraduate Research Program" },
];

const memberships = [
  { year: "Current", body: 'Peer reviewer, <a href="https://www.frontiersin.org/journals/immunology" target="_blank" rel="noopener noreferrer">Frontiers in Immunology</a>' },
  { year: "2014–", body: '<a href="https://isac-net.org/" target="_blank" rel="noopener noreferrer">International Society for the Advancement of Cytometry</a> &middot; Member' },
  { year: "2013–", body: '<a href="https://www.focisnet.org/" target="_blank" rel="noopener noreferrer">Federation of Clinical Immunology Societies</a> &middot; Member' },
  { year: "2016–18", body: "CYTO University eLearning Committee Member, ISAC" },
  { year: "2016, 2017", body: "53rd &amp; 54th Florida Junior Science, Engineering and Humanities Symposium &middot; Poster and Speaker Competition Judge" },
  { year: "2015–16", body: "UF University Minority Mentor Program &middot; Mentor" },
];
---

<Layout title="CV — Howie Seay, Product Development Specialist" description="Howie Seay's CV: product development at Cellares, Rosalind, and BD/FlowJo, plus core facility leadership at the University of Florida. Two granted patents.">
  <header class="page-head">
    <div class="container">
      <p class="eyebrow">Curriculum Vitae</p>
      <h1>Fifteen years making cells count</h1>
      <p>
        From running fee-for-service cytometry cores to leading product for an automated cell
        therapy platform: the instruments, the software, and the science in between.
      </p>
    </div>
  </header>

  <section class="section">
    <div class="container">
      <p class="eyebrow">Experience</p>
      <ol class="timeline">
        {
          roles.map((role) => (
            <li>
              <h3>
                {role.title} <span style="color: var(--cyan)">/</span> {role.org}
              </h3>
              <p class="role-meta">{role.meta}</p>
              <ul>
                {role.points.map((p) => (
                  <li>{p}</li>
                ))}
              </ul>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="section tight">
    <div class="container">
      <p class="eyebrow">Patents</p>
      <ul class="entry-list">
        {patents.map((e) => <li><span class="year">{e.year}</span><span set:html={e.body} /></li>)}
      </ul>
    </div>
  </section>

  <section class="section tight">
    <div class="container">
      <p class="eyebrow">Education</p>
      <ul class="entry-list">
        {education.map((e) => <li><span class="year">{e.year}</span><span set:html={e.body} /></li>)}
      </ul>
    </div>
  </section>

  <section class="section tight">
    <div class="container">
      <p class="eyebrow">Certification &amp; Training</p>
      <ul class="entry-list">
        {certs.map((e) => <li><span class="year">{e.year}</span><span set:html={e.body} /></li>)}
      </ul>
    </div>
  </section>

  <section class="section tight">
    <div class="container">
      <p class="eyebrow">Honors</p>
      <ul class="entry-list">
        {honors.map((e) => <li><span class="year">{e.year}</span><span set:html={e.body} /></li>)}
      </ul>
    </div>
  </section>

  <section class="section tight">
    <div class="container">
      <p class="eyebrow">Memberships &amp; Activities</p>
      <ul class="entry-list">
        {memberships.map((e) => <li><span class="year">{e.year}</span><span set:html={e.body} /></li>)}
      </ul>
    </div>
  </section>
</Layout>
