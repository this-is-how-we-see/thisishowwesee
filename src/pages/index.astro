---
import Layout from "../layouts/Layout.astro";
import Icon from "../components/Icon.astro";
---

<Layout title="how|we|see" description="Flow Cytometry Resources by Howie Seay" bodyClass="landing">
  <section id="banner">
    <span class="banner-icon"><Icon name="flask" /></span>
    <h2>This is Howie Seay</h2>
    <p>For better or for worse</p>
    <ul class="actions">
      <li><a href="/cv" class="button big special">CV</a></li>
    </ul>
  </section>

  <section id="one" class="wrapper style1">
    <div class="inner">
      <article class="feature left">
        <span class="image"><img src="/images/pic01.jpg" alt="" /></span>
        <div class="content">
          <h2>Understanding biology is hard, but flow cytometry doesn't have to be</h2>
          <p>
            In the age of Data Science, it is far too difficult to generate good data. By generating
            reference data and smart algorithms, we can move science faster.
          </p>
          <ul class="actions">
            <li>
              <a href="/flowsites" class="button alt">Flow Resources</a>
            </li>
          </ul>
        </div>
      </article>
      <article class="feature right">
        <span class="image"><img src="/images/pic02.jpg" alt="" /></span>
        <div class="content">
          <h2>Other Musings</h2>
          <p>This is where I am going to put other things and stuff and so forth</p>
          <ul class="actions">
            <li>
              <a href="#" class="button alt">More</a>
            </li>
          </ul>
        </div>
      </article>
    </div>
  </section>

  <section id="two" class="wrapper special">
    <div class="inner">
      <header class="major narrow">
        <h2>In Data, We Trust</h2>
        <p>With Patience, We Thrive</p>
      </header>
      <div class="image-grid">
        <a href="#" class="image"><img src="/images/pic03.jpg" alt="" /></a>
        <a href="#" class="image"><img src="/images/pic04.jpg" alt="" /></a>
        <a href="#" class="image"><img src="/images/pic05.JPG" alt="" /></a>
        <a href="#" class="image"><img src="/images/pic06.jpg" alt="" /></a>
        <a href="#" class="image"><img src="/images/pic07.jpg" alt="" /></a>
        <a href="#" class="image"><img src="/images/pic08.jpg" alt="" /></a>
        <a href="#" class="image"><img src="/images/pic09.jpg" alt="" /></a>
        <a href="#" class="image"><img src="/images/pic10.jpg" alt="" /></a>
      </div>
      <ul class="actions">
        <li><a href="#" class="button big alt">More About The Seay Family</a></li>
      </ul>
    </div>
  </section>

  <section id="three" class="wrapper style3 special">
    <div class="inner">
      <header class="major narrow">
        <h2>Get SH*t Done</h2>
        <p>
          GS*D provides professional services to facilitate growth for your small business. It
          provides skill-building workshops to improve customer DIY efforts and offers full project
          management for customers ready to outsource.
        </p>
      </header>
      <ul class="actions">
        <li>
          <a
            href="https://www.linkedin.com/in/danielle-seay-96628a172/"
            target="_blank"
            rel="noopener noreferrer"
            class="button big alt">Get Serviced</a
          >
        </li>
      </ul>
    </div>
  </section>

  <section id="four" class="wrapper style2 special">
    <div class="inner">
      <header class="major narrow">
        <h2>Get in touch</h2>
        <p>this will go unanswered</p>
      </header>
      <form action="#" method="POST" class="form-narrow">
        <div class="field-row">
          <div>
            <label class="visually-hidden" for="name">Name</label>
            <input id="name" name="name" placeholder="Name" type="text" />
          </div>
          <div>
            <label class="visually-hidden" for="email">Email</label>
            <input id="email" name="email" placeholder="Email" type="email" />
          </div>
          <div class="full">
            <label class="visually-hidden" for="message">Message</label>
            <textarea id="message" name="message" placeholder="Message" rows="4"></textarea>
          </div>
        </div>
        <ul class="actions">
          <li><input type="submit" class="special" value="Submit" /></li>
          <li><input type="reset" class="alt" value="Reset" /></li>
        </ul>
      </form>
    </div>
  </section>
</Layout>
