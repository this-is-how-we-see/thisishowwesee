---
import Layout from "../layouts/Layout.astro";

const services = [
  {
    kicker: "Discovery & strategy",
    title: "Requirements that hold up",
    body: "The work before the roadmap: finding out what users actually need, sizing the opportunity, and turning it into requirements engineering can build without a dozen rounds of clarification. Gathered face to face with the people who use the thing, not assembled from a conference room.",
    points: [
      "Voice-of-customer and user research programs",
      "Requirements that survive contact with engineering",
      "Competitive and market assessment",
      "Opportunity sizing and go/no-go calls",
    ],
  },
  {
    kicker: "Product leadership",
    title: "Fractional and interim product",
    body: "Standing in as the product leader when you need one and do not have one, or backing up the one you have. Roadmaps, pricing, and the business cases that decide where the money goes — then the day-to-day of running them past engineering, sales, and the executives who approve them.",
    points: [
      "Fractional and interim product leadership",
      "Roadmap and release planning across teams",
      "Business cases, ROI models, and pricing structure",
      "Launch planning and go-to-market support",
    ],
  },
  {
    kicker: "Where I go deep",
    title: "Technical and regulated products",
    body: "Product development gets harder when the thing is scientific, the buyer is a specialist, and a regulator has opinions. That is the ground I know best: laboratory instruments, analysis software, and automated manufacturing that has to hold up under FDA-regulated quality systems.",
    points: [
      "Scientific instruments and analysis software",
      "Flow cytometry, spectral analysis, and panel design",
      "Cell therapy manufacturing and GMP automation",
      "Traceability, records, and quality-system readiness",
    ],
  },
];

const engagements = [
  {
    title: "Start with a call",
    body: "Thirty minutes, no charge, to find out whether the problem is one I can actually help with. If it is not, I will usually know who can.",
  },
  {
    title: "Scope the work",
    body: "A short written proposal: the question, what you get, and what it costs. Half-day advisory sessions, fixed-scope projects, and monthly fractional retainers all work.",
  },
  {
    title: "Do the work",
    body: "Alongside your product team, your engineers, or your bench scientists. You get artifacts you can use without me: requirement docs, business cases, roadmaps, protocols.",
  },
];

const schema = [
  {
    "@type": "WebPage",
    "@id": "https://thisishowwesee.com/#webpage",
    url: "https://thisishowwesee.com/",
    name: "How We See LLC — product development consulting",
    about: { "@id": "https://thisishowwesee.com/#business" },
  },
  {
    "@type": "OfferCatalog",
    name: "Consulting services",
    itemListElement: services.map((service) => ({
      "@type": "Offer",
      itemOffered: {
        "@type": "Service",
        name: service.title,
        description: service.body,
        provider: { "@id": "https://thisishowwesee.com/#business" },
      },
    })),
  },
];
---

<Layout
  title="How We See LLC — Product Development Consulting | Howie Seay"
  description="How We See LLC is Howie Seay's consulting practice: product discovery, strategy, roadmaps, pricing, and fractional product leadership for technical and regulated products."
  schema={schema}
>
  <section class="hero">
    <div class="container">
      <p class="eyebrow">How We See LLC</p>
      <h1>Product development for <span class="accent">hard problems</span></h1>
      <p class="hero-lede">
        I am Howie Seay, an innovative product development specialist. How We See LLC is where I
        take products from a vague idea to something people can actually buy and use: discovery and
        requirements, business cases and pricing, roadmaps and launch. Fifteen years of it in
        instruments, software, and regulated manufacturing, where getting it wrong is expensive.
      </p>
      <div class="hero-actions">
        <a href="mailto:howie@thisishowwesee.com" class="button special">Start a conversation</a>
        <a href="/about" class="button">About Howie</a>
      </div>

      <div class="stats">
        <div>
          <span class="stat-num">15+</span>
          <span class="stat-label">Years building products</span>
        </div>
        <div>
          <span class="stat-num">2</span>
          <span class="stat-label">Granted patents</span>
        </div>
        <div>
          <span class="stat-num">30+</span>
          <span class="stat-label">Engineers led</span>
        </div>
        <div>
          <span class="stat-num">15+</span>
          <span class="stat-label">Publications</span>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <p class="eyebrow">01 / Services</p>
      <h2>What How We See does</h2>
      <p style="color: var(--text-dim); margin-bottom: 2.5rem;">
        Three threads, one idea: build the thing people actually need, and know why before you
        build it.
      </p>

      <div class="feature-grid">
        {
          services.map((service) => (
            <article class="feature-card">
              <p class="feature-kicker">{service.kicker}</p>
              <h3>{service.title}</h3>
              <p>{service.body}</p>
              <ul>
                {service.points.map((point) => (
                  <li>{point}</li>
                ))}
              </ul>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <p class="eyebrow">02 / Engagements</p>
      <h2>How it works</h2>
      <ol class="steps">
        {
          engagements.map((step) => (
            <li>
              <h3>{step.title}</h3>
              <p>{step.body}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="split">
        <div>
          <p class="eyebrow">03 / Credentials</p>
          <h2>Why me</h2>
          <p>
            I have led Product across five scrum teams and more than 30 developers, invented and
            patented a method that shipped into a commercial product, built the business cases that
            decided what a Fortune 500 funded, and run a fee-for-service operation with its own
            P&amp;L. The receipts are public.
          </p>
          <div class="hero-actions">
            <a href="/cv" class="button">View CV</a>
            <a href="/pubs" class="button">Publications</a>
          </div>
        </div>
        <div class="split-media">
          <img src="/images/pic01.jpg" alt="" loading="lazy" />
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <p class="eyebrow">04 / Resources</p>
      <h2>Free, before you hire anyone</h2>
      <p>
        A curated guide to flow cytometry for anyone working in it, and a compensation guide so you
        know what this work is worth on either side of the table. Both are free and neither asks for
        your email.
      </p>
      <div class="hero-actions">
        <a href="/flowsites" class="button">Flow resources</a>
        <a href="/compensation" class="button">Compensation guide</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <p class="eyebrow">05 / Contact</p>
      <h2>Let's talk</h2>
      <p>
        Tell me what you are building and where it is stuck. Email is the fastest way to reach How
        We See LLC; LinkedIn works too.
      </p>
      <div class="hero-actions">
        <a href="mailto:howie@thisishowwesee.com" class="button special"
          >howie@thisishowwesee.com</a
        >
        <a
          href="https://www.linkedin.com/in/this-is-how-we-see/"
          target="_blank"
          rel="noopener noreferrer"
          class="button">Connect on LinkedIn</a
        >
      </div>
    </div>
  </section>
</Layout>
