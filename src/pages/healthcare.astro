---
/**
 * Passcode-gated coverage decision sheet.
 *
 * The content is NOT in this page. It ships as AES-GCM ciphertext at
 * /plan/healthcare.json and is decrypted in the browser with a key
 * derived from the passcode, so the plaintext is absent from both the public
 * repo and the deployed HTML. Regenerate the payload with:
 *
 *   node scripts/encrypt-plan.mjs
 *
 * Deliberately absent from the nav in Layout.astro, and noindexed.
 */
import Layout from "../layouts/Layout.astro";
---

<Layout title="Private" description="A private document." noindex={true}>
  <div class="gate" id="gate">
    <div class="gate-inner">
      <p class="gate-eyebrow">Private</p>
      <h1 class="gate-title">Enter the passcode</h1>
      <p class="gate-sub">Four digits. Ask Howie if you need them.</p>

      <div class="pips" id="pips" aria-hidden="true">
        <span></span><span></span><span></span><span></span>
      </div>

      <div class="keypad" id="keypad" role="group" aria-label="Passcode keypad">
        <button type="button" data-key="1">1</button>
        <button type="button" data-key="2">2</button>
        <button type="button" data-key="3">3</button>
        <button type="button" data-key="4">4</button>
        <button type="button" data-key="5">5</button>
        <button type="button" data-key="6">6</button>
        <button type="button" data-key="7">7</button>
        <button type="button" data-key="8">8</button>
        <button type="button" data-key="9">9</button>
        <button type="button" data-action="clear" class="k-alt">Clear</button>
        <button type="button" data-key="0">0</button>
        <button type="button" data-action="delete" class="k-alt" aria-label="Delete">⌫</button>
      </div>

      <p class="gate-status" id="status" role="status" aria-live="polite">
        You can also type on your keyboard.
      </p>
    </div>
  </div>

  <article class="plan-doc" id="doc" hidden></article>
</Layout>

<style is:global>
  /* ---------- Gate ---------- */

  .gate {
    min-height: 68vh;
    display: grid;
    place-items: center;
    padding: clamp(3rem, 8vw, 6rem) var(--gutter);
  }

  .gate-inner {
    width: 100%;
    max-width: 20rem;
    text-align: center;
  }

  .gate-eyebrow {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--cyan);
    margin-bottom: 0.85rem;
  }

  .gate-title {
    font-family: var(--font-display);
    font-size: 1.6rem;
    font-weight: 500;
    letter-spacing: -0.01em;
    margin-bottom: 0.4rem;
  }

  .gate-sub {
    color: var(--text-dim);
    font-size: 0.92rem;
    margin-bottom: 2rem;
  }

  .pips {
    display: flex;
    justify-content: center;
    gap: 0.9rem;
    margin-bottom: 2.25rem;
  }

  .pips span {
    width: 0.7rem;
    height: 0.7rem;
    border-radius: 50%;
    border: 1px solid var(--line-strong);
    transition: background-color var(--ease), border-color var(--ease), transform var(--ease);
  }

  .pips span.filled {
    background: var(--cyan);
    border-color: var(--cyan);
    transform: scale(1.1);
  }

  .keypad {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.75rem;
  }

  .keypad button {
    aspect-ratio: 1.35;
    background: var(--bg-elev);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    color: var(--text);
    font-family: var(--font-mono);
    font-size: 1.35rem;
    cursor: pointer;
    transition:
      background-color var(--ease),
      border-color var(--ease),
      transform var(--ease);
  }

  .keypad button:hover {
    background: var(--bg-elev-2);
    border-color: var(--line-strong);
  }

  .keypad button:active {
    transform: scale(0.96);
    border-color: var(--cyan);
  }

  .keypad button:focus-visible {
    outline: 2px solid var(--cyan);
    outline-offset: 2px;
  }

  .keypad .k-alt {
    font-size: 0.8rem;
    letter-spacing: 0.06em;
    color: var(--text-dim);
  }

  .gate-status {
    margin-top: 1.75rem;
    min-height: 1.4em;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.04em;
    color: var(--text-faint);
  }

  .gate-status.is-error {
    color: #fb7185;
  }

  .gate-inner.shake {
    animation: gate-shake 380ms cubic-bezier(0.36, 0.07, 0.19, 0.97);
  }

  @keyframes gate-shake {
    10%, 90% { transform: translateX(-2px); }
    20%, 80% { transform: translateX(4px); }
    30%, 50%, 70% { transform: translateX(-7px); }
    40%, 60% { transform: translateX(7px); }
  }

  @media (prefers-reduced-motion: reduce) {
    .gate-inner.shake { animation: none; }
    .pips span,
    .keypad button { transition: none; }
  }

  /* ---------- Plan document ---------- */

  .plan-doc {
    --p-accent: var(--cyan);
    --p-good: #4ade80;
    --p-warn: #f59e0b;
    --p-bad: #fb7185;

    max-width: 54rem;
    margin: 0 auto;
    padding: clamp(2.5rem, 6vw, 4.5rem) var(--gutter) 6rem;
    font-size: 1rem;
    line-height: 1.68;
    color: var(--text);
  }

  .plan-doc p,
  .plan-doc ul,
  .plan-doc ol {
    max-width: var(--measure);
  }

  .plan-doc p { margin-bottom: 1rem; }
  .plan-doc ul, .plan-doc ol { margin-bottom: 1rem; padding-left: 1.3em; }
  .plan-doc li { margin-bottom: 0.45rem; }
  .plan-doc strong { color: var(--text); font-weight: 600; }
  .plan-doc em { font-style: italic; color: var(--text); }

  .plan-doc .plan-head {
    padding-bottom: 2.5rem;
    border-bottom: 1px solid var(--line-strong);
  }

  .plan-doc .eyebrow,
  .plan-doc .sec-label {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--p-accent);
    margin-bottom: 0.75rem;
  }

  .plan-doc h1 {
    font-family: var(--font-display);
    font-size: clamp(2rem, 5vw, 2.9rem);
    font-weight: 700;
    line-height: 1.08;
    letter-spacing: -0.02em;
    text-wrap: balance;
    margin-bottom: 1rem;
  }

  .plan-doc h2 {
    font-family: var(--font-display);
    font-size: clamp(1.4rem, 3vw, 1.85rem);
    font-weight: 500;
    line-height: 1.2;
    letter-spacing: -0.01em;
    text-wrap: balance;
    margin-bottom: 1rem;
  }

  .plan-doc h3 {
    font-family: var(--font-display);
    font-size: 1.15rem;
    font-weight: 500;
    margin: 2.25rem 0 0.6rem;
  }

  .plan-doc .dek {
    font-size: 1.08rem;
    color: var(--text-dim);
    max-width: 42em;
    margin-bottom: 1.5rem;
  }

  .plan-doc .lede {
    font-size: 1.06rem;
    color: var(--text-dim);
  }

  .plan-doc .byline {
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem 1.4rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--text-faint);
    max-width: none;
  }

  .plan-doc section { margin-top: 4rem; }

  /* at-a-glance */
  .plan-doc .glance {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(11rem, 1fr));
    gap: 1px;
    background: var(--line);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    overflow: hidden;
    margin-top: 2.5rem;
  }

  .plan-doc .glance > div {
    background: var(--bg-elev);
    padding: 1rem 1.1rem;
  }

  .plan-doc .glance .k {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-faint);
    margin-bottom: 0.4rem;
  }

  .plan-doc .glance .v {
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--p-accent);
    line-height: 1.1;
    font-variant-numeric: tabular-nums;
    margin-bottom: 0.25rem;
  }

  .plan-doc .glance .s {
    font-size: 0.78rem;
    color: var(--text-dim);
    line-height: 1.4;
    margin: 0;
  }

  /* legend */
  .plan-doc .legend {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.6rem 1.35rem;
    margin-top: 1.5rem;
    padding: 0.9rem 1.1rem;
    background: var(--bg-elev);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    font-size: 0.82rem;
    color: var(--text-dim);
    max-width: none;
  }

  .plan-doc .legend > strong {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-faint);
    font-weight: 500;
  }

  .plan-doc .legend .li {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .plan-doc .hl { color: var(--p-accent); }

  /* confidence chips */
  .plan-doc .chip {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 0.6rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    font-weight: 500;
    padding: 0.15rem 0.45rem;
    border-radius: 3px;
    white-space: nowrap;
    vertical-align: 0.1em;
  }

  .plan-doc .c-meas { background: rgba(74, 222, 128, 0.14); color: var(--p-good); }
  .plan-doc .c-der { background: rgba(242, 245, 247, 0.08); color: var(--text-dim); }
  .plan-doc .c-assum { background: rgba(245, 158, 11, 0.14); color: var(--p-warn); }

  .plan-doc .tag {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.08em;
    padding: 0.1rem 0.45rem;
    border-radius: 3px;
    background: rgba(34, 211, 238, 0.12);
    color: var(--cyan);
    white-space: nowrap;
  }

  /* tables */
  .plan-doc .tbl-wrap {
    overflow-x: auto;
    margin: 1.4rem 0 1.6rem;
    border: 1px solid var(--line);
    border-radius: var(--radius);
  }

  .plan-doc table {
    border-collapse: collapse;
    width: 100%;
    font-size: 0.86rem;
    background: var(--bg-elev);
  }

  .plan-doc th {
    text-align: left;
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    font-weight: 500;
    color: var(--text-faint);
    padding: 0.7rem 0.95rem;
    background: var(--bg-elev-2);
    border-bottom: 1px solid var(--line-strong);
    white-space: nowrap;
  }

  .plan-doc td {
    padding: 0.65rem 0.95rem;
    border-bottom: 1px solid var(--line);
    vertical-align: top;
    line-height: 1.5;
  }

  .plan-doc tbody tr:last-child td { border-bottom: none; }

  .plan-doc td.num,
  .plan-doc th.num {
    text-align: right;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  .plan-doc td .sub {
    display: block;
    font-size: 0.76rem;
    color: var(--text-faint);
    margin-top: 0.15rem;
  }

  .plan-doc tfoot td {
    font-weight: 600;
    background: var(--bg-elev-2);
    border-top: 1px solid var(--line-strong);
    border-bottom: none;
  }

  /* funnel */
  .plan-doc .funnel {
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
    margin: 1.75rem 0 0.5rem;
  }

  .plan-doc .frow {
    display: grid;
    grid-template-columns: 4.5rem 1fr;
    gap: 1rem;
    align-items: center;
  }

  .plan-doc .flabel {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    color: var(--text-faint);
    text-align: right;
  }

  .plan-doc .fbar {
    height: 2.9rem;
    border-radius: var(--radius);
    display: flex;
    align-items: center;
    padding: 0 0.9rem;
    min-width: min-content;
  }

  .plan-doc .fbar .fv {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 0.95rem;
    color: var(--bg);
    white-space: nowrap;
  }

  .plan-doc .w-100 { width: 100%; background: var(--cyan); }
  .plan-doc .w-46 { width: 46%; background: var(--violet); }
  .plan-doc .w-22 { width: 22%; background: var(--magenta); }

  .plan-doc .fnote {
    grid-column: 2;
    font-size: 0.78rem;
    color: var(--text-faint);
    margin: 0.35rem 0 0;
  }

  /* expandable math */
  .plan-doc details.math {
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--bg-elev);
    margin: 1.4rem 0 1.6rem;
    overflow: hidden;
  }

  .plan-doc details.math > summary {
    list-style: none;
    cursor: pointer;
    padding: 0.7rem 1rem;
    background: var(--bg-elev-2);
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--p-accent);
    display: flex;
    align-items: center;
    gap: 0.65rem;
    flex-wrap: wrap;
  }

  .plan-doc details.math > summary::-webkit-details-marker { display: none; }

  .plan-doc details.math > summary::before {
    content: "+";
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1rem;
    height: 1rem;
    border: 1px solid currentColor;
    border-radius: 2px;
    font-size: 0.75rem;
    line-height: 1;
    flex-shrink: 0;
  }

  .plan-doc details.math[open] > summary::before { content: "–"; }
  .plan-doc details.math > summary:hover { color: var(--text); }

  .plan-doc details.math > summary:focus-visible {
    outline: 2px solid var(--cyan);
    outline-offset: -2px;
  }

  .plan-doc .math-body {
    padding: 1.1rem 1rem 0.4rem;
    border-top: 1px solid var(--line);
  }

  .plan-doc .math-body p,
  .plan-doc .math-body ul {
    max-width: none;
    font-size: 0.92rem;
  }

  .plan-doc .ledger {
    display: grid;
    grid-template-columns: 1fr auto;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    margin: 1rem 0 1.1rem;
    border-top: 1px solid var(--line);
  }

  .plan-doc .ledger > div {
    padding: 0.5rem 0;
    border-bottom: 1px solid var(--line);
    line-height: 1.45;
  }

  .plan-doc .ledger .ll { color: var(--text-dim); padding-right: 1.25rem; }

  .plan-doc .ledger .lv {
    text-align: right;
    font-variant-numeric: tabular-nums;
    color: var(--text);
    white-space: nowrap;
  }

  .plan-doc .ledger .sum {
    color: var(--p-accent);
    font-weight: 500;
    border-bottom-color: var(--line-strong);
  }

  .plan-doc .ledger .op { color: var(--p-accent); }

  .plan-doc .src {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    line-height: 1.55;
    color: var(--text-faint);
    max-width: none;
  }

  .plan-doc .src b { color: var(--text-dim); font-weight: 500; }

  /* callout */
  .plan-doc .callout {
    border: 1px solid var(--line);
    border-left: 2px solid var(--p-accent);
    border-radius: 0 var(--radius) var(--radius) 0;
    background: var(--bg-elev);
    padding: 1.1rem 1.25rem;
    margin: 1.5rem 0;
  }

  .plan-doc .callout p:last-child { margin-bottom: 0; }

  .plan-doc .co-title {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--p-accent);
    margin-bottom: 0.6rem;
  }

  /* lab flow */
  .plan-doc .flow {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem;
    margin: 1.4rem 0 1.6rem;
  }

  .plan-doc .step {
    flex: 1 1 10rem;
    min-width: 10rem;
    background: var(--bg-elev);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 0.85rem 0.95rem;
  }

  .plan-doc .step .n {
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--p-accent);
    margin-bottom: 0.35rem;
  }

  .plan-doc .step .t {
    font-weight: 600;
    font-size: 0.9rem;
    line-height: 1.3;
    margin-bottom: 0.25rem;
  }

  .plan-doc .step .d {
    font-size: 0.8rem;
    color: var(--text-dim);
    line-height: 1.45;
  }

  /* law cards */
  .plan-doc .law {
    display: grid;
    gap: 1rem;
    margin: 1.5rem 0;
  }

  .plan-doc .law-card {
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--bg-elev);
    overflow: hidden;
  }

  .plan-doc .law-card .head {
    padding: 0.7rem 1.1rem;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    font-weight: 500;
  }

  .plan-doc .law-card .body {
    padding: 1rem 1.1rem 0.4rem;
    border-top: 1px solid var(--line);
  }

  .plan-doc .law-card ul { max-width: none; }

  .plan-doc .law-req .head { background: rgba(74, 222, 128, 0.12); color: var(--p-good); }
  .plan-doc .law-rec .head { background: rgba(245, 158, 11, 0.12); color: var(--p-warn); }
  .plan-doc .law-no .head { background: rgba(251, 113, 133, 0.12); color: var(--p-bad); }

  /* checklist */
  .plan-doc .checklist {
    counter-reset: step;
    list-style: none;
    padding-left: 0;
    max-width: none;
  }

  .plan-doc .checklist li {
    counter-increment: step;
    display: grid;
    grid-template-columns: 2.4rem 1fr;
    gap: 0.9rem;
    padding: 0.8rem 0;
    margin: 0;
    border-bottom: 1px solid var(--line);
    align-items: baseline;
  }

  .plan-doc .checklist li::before {
    content: counter(step, decimal-leading-zero);
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--p-accent);
  }

  .plan-doc .checklist li:last-child { border-bottom: none; }

  .plan-doc .checklist .when {
    display: block;
    font-family: var(--font-mono);
    font-size: 0.65rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-faint);
    margin-top: 0.2rem;
  }

  /* footer */
  .plan-doc .plan-foot {
    margin-top: 4.5rem;
    padding-top: 1.75rem;
    border-top: 1px solid var(--line-strong);
    font-size: 0.8rem;
    color: var(--text-faint);
  }

  .plan-doc .plan-foot p { max-width: 58em; }

  @media (max-width: 34rem) {
    .plan-doc .frow { grid-template-columns: 1fr; }
    .plan-doc .flabel { text-align: left; }
    .plan-doc .fnote { grid-column: 1; }
    .plan-doc .ledger { font-size: 0.72rem; }
  }
</style>

<script>
  const PAYLOAD_URL = "/plan/healthcare.json";
  const LENGTH = 4;
  const STORAGE_KEY = "plan:healthcare";

  const gate = document.getElementById("gate")!;
  const inner = gate.querySelector<HTMLElement>(".gate-inner")!;
  const keypad = document.getElementById("keypad")!;
  const pips = Array.from(document.querySelectorAll<HTMLElement>("#pips span"));
  const status = document.getElementById("status")!;
  const doc = document.getElementById("doc")!;

  let entry = "";
  let busy = false;
  let payload: { kdf: { salt: string; iterations: number; hash: string }; iv: string; ct: string } | null = null;

  const HINT = "You can also type on your keyboard.";

  function bytes(base64: string) {
    return Uint8Array.from(atob(base64), (c) => c.charCodeAt(0));
  }

  function render() {
    pips.forEach((pip, i) => pip.classList.toggle("filled", i < entry.length));
  }

  function setStatus(message: string, isError = false) {
    status.textContent = message;
    status.classList.toggle("is-error", isError);
  }

  function reject(message: string) {
    entry = "";
    render();
    setStatus(message, true);
    inner.classList.remove("shake");
    void inner.offsetWidth; // restart the animation
    inner.classList.add("shake");
  }

  async function getPayload() {
    if (payload) return payload;
    const response = await fetch(PAYLOAD_URL);
    if (!response.ok) throw new Error(`payload ${response.status}`);
    payload = await response.json();
    return payload!;
  }

  async function decrypt(passcode: string) {
    const data = await getPayload();

    const baseKey = await crypto.subtle.importKey(
      "raw",
      new TextEncoder().encode(passcode),
      "PBKDF2",
      false,
      ["deriveKey"],
    );

    const key = await crypto.subtle.deriveKey(
      {
        name: "PBKDF2",
        salt: bytes(data.kdf.salt),
        iterations: data.kdf.iterations,
        hash: data.kdf.hash,
      },
      baseKey,
      { name: "AES-GCM", length: 256 },
      false,
      ["decrypt"],
    );

    // AES-GCM is authenticated: a wrong passcode fails here rather than
    // yielding garbage, so this doubles as the passcode check.
    const plaintext = await crypto.subtle.decrypt(
      { name: "AES-GCM", iv: bytes(data.iv) },
      key,
      bytes(data.ct),
    );

    return new TextDecoder().decode(plaintext);
  }

  function reveal(html: string) {
    doc.innerHTML = html;
    doc.hidden = false;
    gate.remove();
    // Take the title from the decrypted content. Hardcoding it here would ship
    // the private document's name in the public JS bundle.
    const heading = doc.querySelector("h1")?.textContent?.trim();
    if (heading) document.title = `${heading} — private`;
    window.scrollTo(0, 0);
  }

  async function attempt(passcode: string, { silent = false } = {}) {
    busy = true;
    setStatus("Unlocking…");

    try {
      const html = await decrypt(passcode);
      sessionStorage.setItem(STORAGE_KEY, passcode);
      reveal(html);
    } catch (error) {
      busy = false;
      sessionStorage.removeItem(STORAGE_KEY);
      if (silent) {
        setStatus(HINT);
        return;
      }
      // A failed fetch and a wrong passcode are different problems.
      const isNetwork = error instanceof Error && error.message.startsWith("payload");
      reject(isNetwork ? "Couldn't load the page. Check your connection." : "That's not it — try again.");
    }
  }

  function push(digit: string) {
    if (busy || entry.length >= LENGTH) return;
    entry += digit;
    render();
    if (status.classList.contains("is-error")) setStatus(HINT);
    if (entry.length === LENGTH) attempt(entry);
  }

  keypad.addEventListener("click", (event) => {
    const button = (event.target as HTMLElement).closest<HTMLButtonElement>("button");
    if (!button) return;

    if (button.dataset.key) push(button.dataset.key);
    else if (button.dataset.action === "delete") {
      entry = entry.slice(0, -1);
      render();
    } else if (button.dataset.action === "clear") {
      entry = "";
      render();
      setStatus(HINT);
    }
  });

  document.addEventListener("keydown", (event) => {
    if (doc.hidden === false) return;

    if (/^\d$/.test(event.key)) {
      push(event.key);
    } else if (event.key === "Backspace") {
      event.preventDefault();
      if (busy) return;
      entry = entry.slice(0, -1);
      render();
    } else if (event.key === "Escape") {
      if (busy) return;
      entry = "";
      render();
      setStatus(HINT);
    }
  });

  // Web Crypto needs a secure context; say so plainly rather than failing oddly.
  if (!window.isSecureContext || !crypto?.subtle) {
    setStatus("This page needs a secure (https) connection.", true);
    keypad.querySelectorAll("button").forEach((button) => (button.disabled = true));
  } else {
    // Survive a refresh mid-read without retyping.
    const remembered = sessionStorage.getItem(STORAGE_KEY);
    if (remembered) attempt(remembered, { silent: true });
  }
</script>
