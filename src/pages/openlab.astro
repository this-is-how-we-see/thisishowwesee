---
import Layout from "../layouts/Layout.astro";
import PrivateDoc from "../components/PrivateDoc.astro";

/**
 * Study notes on chromatography data systems and the Agilent OpenLab portfolio.
 *
 * The content is NOT here. It lives in a private Vercel Blob as
 * private/openlab.src.html and arrives through /api/private-doc once Google
 * verifies the reader. This page is the gate plus the styling and behaviour
 * the document needs.
 *
 * The flashcards are why this page has a script at all. A private document is
 * injected with innerHTML, which never executes a script inside it, so the
 * behaviour has to live out here and bind after the markup lands. PrivateDoc
 * fires `privatedoc:ready` for exactly this.
 */
---

<Layout
  title="Lab software — private"
  description="Private study notes."
  noindex={true}
>
  <PrivateDoc slug="openlab" eyebrow="Study notes" />
</Layout>

<style is:global>
  .ol-toc {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.5rem;
    margin-top: 1.5rem;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .ol-h3 {
    margin-top: 3rem;
    font-size: 1.15rem;
    letter-spacing: 0.01em;
  }

  /* ---------- controls ---------- */
  .ol-controls {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin: 2rem 0 1.5rem;
  }

  .ol-filters {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .ol-chip {
    padding: 0.35rem 0.8rem;
    border: 1px solid var(--line-strong);
    border-radius: 999px;
    background: transparent;
    color: var(--text-dim);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    cursor: pointer;
    transition: color var(--ease), border-color var(--ease), background var(--ease);
  }

  .ol-chip:hover { color: var(--text); border-color: var(--cyan); }

  .ol-chip.is-on {
    color: var(--bg);
    background: var(--cyan);
    border-color: var(--cyan);
  }

  .ol-actions {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .ol-count {
    margin: 0;
    color: var(--text-faint);
    font-family: var(--font-mono);
    font-size: 0.75rem;
  }

  /* ---------- deck ---------- */
  .ol-deck {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(230px, 1fr));
    gap: 1rem;
  }

  .ol-card {
    display: block;
    width: 100%;
    min-height: 190px;
    padding: 0;
    border: 0;
    background: transparent;
    perspective: 1200px;
    cursor: pointer;
    text-align: left;
    font: inherit;
    color: inherit;
  }

  .ol-card:focus-visible { outline: 2px solid var(--cyan); outline-offset: 3px; }

  /* Both faces share one grid cell, so the card sizes itself to the taller of
     the two. The earlier version absolutely positioned them and gave each an
     overflow, which silently broke backface-visibility: an element with
     overflow other than visible stops honouring it, so the front face stayed
     drawn on top of the rotated back. */
  .ol-card-inner {
    position: relative;
    display: grid;
    width: 100%;
    min-height: 190px;
    transform-style: preserve-3d;
    transition: transform 420ms cubic-bezier(0.4, 0, 0.2, 1);
  }

  .ol-card[aria-pressed="true"] .ol-card-inner { transform: rotateY(180deg); }

  .ol-face {
    grid-area: 1 / 1;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    padding: 1.1rem;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius);
    background: var(--bg-elev);
    backface-visibility: hidden;
  }

  .ol-front { justify-content: space-between; }

  .ol-card:hover .ol-front { border-color: var(--cyan); }

  .ol-cat {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-faint);
  }

  .ol-term {
    font-family: var(--font-display);
    font-size: 1.2rem;
    line-height: 1.25;
    color: var(--text);
  }

  .ol-hint {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-faint);
  }

  .ol-back {
    transform: rotateY(180deg);
    background: var(--bg-elev-2);
    border-color: var(--line-strong);
    border-left: 2px solid var(--violet);
  }

  .ol-def {
    font-size: 0.86rem;
    line-height: 1.55;
    color: var(--text-dim);
  }

  .ol-def strong { color: var(--text); }
  .ol-def em { color: var(--text); font-style: italic; }

  .ol-card.is-hidden { display: none; }

  /* ---------- panels ---------- */
  .ol-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1rem;
    margin-top: 1.5rem;
  }

  .ol-panel {
    padding: 1.4rem;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--bg-elev);
  }

  .ol-panel p { max-width: none; font-size: 0.92rem; }

  .ol-panel-kicker {
    margin: 0 0 0.35rem;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--cyan);
  }

  .ol-panel-title {
    margin: 0 0 0.6rem;
    font-size: 1.05rem;
  }

  .ol-panel ul {
    margin: 0;
    padding-left: 1.1rem;
    font-size: 0.9rem;
    line-height: 1.6;
    color: var(--text-dim);
  }

  .ol-panel li + li { margin-top: 0.4rem; }

  .ol-reflist { list-style: none; padding-left: 0; }
  .ol-reflist li + li { margin-top: 0.5rem; }

  /* ---------- callout ---------- */
  .ol-note {
    margin: 2rem 0;
    padding: 1.3rem 1.5rem;
    border: 1px solid var(--line-strong);
    border-left: 3px solid var(--magenta);
    border-radius: var(--radius);
    background: var(--bg-elev-2);
  }

  .ol-note p { margin: 0; max-width: none; }

  /* ---------- timeline ---------- */
  .ol-timeline {
    list-style: none;
    margin: 2rem 0 0;
    padding: 0;
    border-left: 1px solid var(--line-strong);
  }

  .ol-tl-item {
    position: relative;
    display: grid;
    grid-template-columns: 7.5rem 1fr;
    gap: 1.25rem;
    padding: 0 0 2rem 1.75rem;
  }

  .ol-tl-item::before {
    content: "";
    position: absolute;
    left: -5px;
    top: 0.45rem;
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--text-faint);
  }

  .ol-tl-item.is-mark::before { background: var(--cyan); box-shadow: 0 0 0 4px rgba(34, 211, 238, 0.15); }

  .ol-tl-year {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    letter-spacing: 0.04em;
    color: var(--text-faint);
    padding-top: 0.15rem;
  }

  .ol-tl-item.is-mark .ol-tl-year { color: var(--cyan); }

  .ol-tl-head { margin: 0 0 0.35rem; font-size: 1.05rem; }
  .ol-tl-body p { margin: 0; font-size: 0.92rem; }

  @media (max-width: 640px) {
    .ol-tl-item { grid-template-columns: 1fr; gap: 0.3rem; }
    .ol-controls { flex-direction: column; align-items: flex-start; }
  }

  @media (prefers-reduced-motion: reduce) {
    .ol-card-inner { transition: none; }
  }
</style>

<script>
  // Bind once the gated document is on the page. Everything below assumes the
  // markup does not exist yet at parse time, because it does not.
  document.addEventListener("privatedoc:ready", (event) => {
    const root = (event as CustomEvent).detail?.root as HTMLElement | undefined;
    if (!root) return;

    const deck = root.querySelector("#ol-deck");
    const countEl = root.querySelector("#ol-count");
    if (!deck || !countEl) return;

    const cards = () => Array.from(deck.querySelectorAll(".ol-card"));

    const updateCount = () => {
      const visible = cards().filter((c) => !c.classList.contains("is-hidden"));
      countEl.textContent = `${visible.length} card${visible.length === 1 ? "" : "s"}`;
    };

    // aria-pressed carries the flip state, so the CSS and the accessibility
    // tree never disagree about which face is showing.
    deck.addEventListener("click", (e) => {
      const card = (e.target as HTMLElement).closest(".ol-card");
      if (!card) return;
      card.setAttribute("aria-pressed", card.getAttribute("aria-pressed") === "true" ? "false" : "true");
    });

    root.querySelectorAll(".ol-chip").forEach((chip) => {
      chip.addEventListener("click", () => {
        const cat = (chip as HTMLElement).dataset.cat;
        root.querySelectorAll(".ol-chip").forEach((c) => c.classList.toggle("is-on", c === chip));
        cards().forEach((card) => {
          card.classList.toggle("is-hidden", cat !== "All" && (card as HTMLElement).dataset.cat !== cat);
          card.setAttribute("aria-pressed", "false");
        });
        updateCount();
      });
    });

    root.querySelector("#ol-shuffle")?.addEventListener("click", () => {
      const list = cards();
      for (let i = list.length - 1; i > 0; i -= 1) {
        const j = Math.floor(Math.random() * (i + 1));
        deck.appendChild(list[j]);
        list.splice(j, 1);
      }
      if (list[0]) deck.appendChild(list[0]);
      cards().forEach((card) => card.setAttribute("aria-pressed", "false"));
    });

    root.querySelector("#ol-flipall")?.addEventListener("click", () => {
      const visible = cards().filter((c) => !c.classList.contains("is-hidden"));
      const anyFront = visible.some((c) => c.getAttribute("aria-pressed") !== "true");
      visible.forEach((c) => c.setAttribute("aria-pressed", anyFront ? "true" : "false"));
    });

    updateCount();
  });
</script>
