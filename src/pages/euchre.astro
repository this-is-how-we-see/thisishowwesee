    $("run").textContent = "Estimating...";
    setTimeout(() => {
      try {
        const opts = readOptions();
        const odds = estimateCallOdds(opts);
        const threshold = callThresholdInfo(opts.hand, opts.seat, opts.dealer, opts.upcard, opts.trump, opts.roundNo);
        const v = callVerdict(odds, threshold);
        const scenarios = scenarioComparison(opts, { odds, threshold, verdict: v });
        const recommendation = expertRecommendation(scenarios);
        renderAll(opts, odds, threshold, v, scenarios, recommendation);
      } catch (err) {
        $("error").textContent = err.message;
        $("error").style.display = "block";
      } finally {
        $("run").disabled = false;
        $("run").textContent = "Estimate Odds";
      }
    }, 20);
  }
  function renderAll(opts, odds, threshold, v, scenarios, recommendation) {
    const hand = handText(opts.hand), up = cardName(opts.upcard);
    renderTable(hand, up, opts.seat, opts.dealer, opts.trump);
    $("recommendationAction").textContent = recommendation.action;
    $("recommendationReason").textContent = recommendation.reason;
    $("recommendationBox").className = `recommendation ${recommendation.tone}`;
    renderScenario("scenarioSelected", scenarios.selected);
    renderScenario("scenarioUpcard", scenarios.upcard);
    renderScenario("scenarioRound2", scenarios.best_round2);
    $("scoreMetric").textContent = Number(threshold.score).toFixed(2);
    $("thresholdMetric").textContent = Number(threshold.threshold).toFixed(2);
    $("margin").textContent = signed(threshold.margin);
    $("expected").textContent = Number(odds.expected_points).toFixed(3);
    $("net").textContent = signed(odds.expected_net_points);
    $("make").textContent = pct(odds.make_pct);
    $("march").textContent = pct(odds.march_pct);
    $("euchred").textContent = pct(odds.euchred_pct);
    $("one").textContent = pct(odds.one_point_pct);
    $("rel").textContent = odds.caller_rel;
    $("called").textContent = suitName[opts.trump];
    $("tricks").textContent = Number(odds.avg_maker_tricks).toFixed(2);
    $("four").textContent = pct(odds.four_point_pct);
    $("aloneRate").textContent = pct(odds.alone_pct);
    $("sampleCount").textContent = odds.samples;
    $("shape").textContent = `T${threshold.trump_count} B${threshold.bowers} A${threshold.off_aces} 2s${threshold.two_suited}`;
    $("basis").textContent = threshold.exception || threshold.basis;
  }
  function randomize() {
    const cards = shuffle(deck());
    const hand = cards.slice(0, 5).sort((a, b) => a - b);
    const up = cards[5];
    $("hand").value = handText(hand);
    $("upcard").value = cardName(up);
    $("trump").value = cardSuit(up);
    runOdds();
  }
  $("run").addEventListener("click", runOdds);
  $("randomize").addEventListener("click", randomize);
  renderTable($("hand").value, $("upcard").value, Number($("seat").value), Number($("dealer").value), $("trump").value);
</script>
</Layout>
