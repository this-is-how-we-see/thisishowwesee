---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Euchre Call Odds" description="A browser-based Stick-the-Dealer Euchre call simulator.">
  <header class="page-head">
    <div class="container">
      <p class="eyebrow">Projects</p>
      <h1>Euchre Call Odds</h1>
      <p>
        Generate a hand, compare the call lines, and get a clear expert-style recommendation &mdash;
        backed by Monte Carlo simulation over your seat, the upcard, and the score.
      </p>
    </div>
  </header>

  <section class="section tight">
    <div class="container euchre-tool">

      <div class="euchre-grid">
        <section class="panel">
          <h3>Call Setup</h3>
          <label for="hand">Your hand</label>
          <input id="hand" value="9C KC AD JH JS" />
          <p class="hint">Use cards like AH, JD, 10S, 9C.</p>

          <label for="upcard">Upcard</label>
          <input id="upcard" value="AC" />

          <div class="field-grid">
            <div>
              <label for="seat">Your seat</label>
              <select id="seat">
                <option value="0">0</option>
                <option value="1">1</option>
                <option value="2">2</option>
                <option value="3">3</option>
              </select>
            </div>
            <div>
              <label for="dealer">Dealer</label>
              <select id="dealer">
                <option value="3">3</option>
                <option value="0">0</option>
                <option value="1">1</option>
                <option value="2">2</option>
              </select>
            </div>
          </div>

          <div class="field-grid">
            <div>
              <label for="round">Round</label>
              <select id="round">
                <option value="1">1: order/pick up</option>
                <option value="2">2: name suit</option>
              </select>
            </div>
            <div>
              <label for="trump">Call suit</label>
              <select id="trump">
                <option value="C">♣ Clubs</option>
                <option value="D">♦ Diamonds</option>
                <option value="H">♥ Hearts</option>
                <option value="S">♠ Spades</option>
              </select>
            </div>
          </div>

          <div class="field-grid">
            <div>
              <label for="score">Score</label>
              <input id="score" value="0-0" />
            </div>
            <div>
              <label for="samples">Samples</label>
              <input id="samples" type="number" min="100" max="50000" step="100" value="5000" />
            </div>
          </div>

          <label for="alone">Loner choice</label>
          <select id="alone">
            <option value="auto">Auto</option>
            <option value="no">Do not go alone</option>
            <option value="yes">Force loner</option>
          </select>

          <div class="button-row">
            <button id="randomize" type="button" class="button alt">Random Hand</button>
            <button id="run" type="button" class="button special">Estimate Odds</button>
          </div>
          <div id="error" class="error"></div>
        </section>

        <section class="panel result-panel">
          <div id="tableView" class="table-view"></div>

          <div id="recommendationBox" class="recommendation">
            <span>Expert recommendation</span>
            <b id="recommendationAction">-</b>
            <p id="recommendationReason">Generate a hand and estimate odds.</p>
          </div>

          <div class="scenario-grid">
            <div class="scenario-card" id="scenarioSelected"></div>
            <div class="scenario-card" id="scenarioUpcard"></div>
            <div class="scenario-card" id="scenarioRound2"></div>
          </div>

          <details class="help-box">
            <summary>How the recommendation works</summary>
            <ul>
              <li><b>Call</b>: positive net value, good make rate, and acceptable euchre risk.</li>
              <li><b>Lean call</b>: playable but score/table context matters.</li>
              <li><b>Lean pass</b>: gray area, but the risk/reward is not attractive.</li>
              <li><b>Pass</b>: high euchre risk or clearly negative net value.</li>
              <li><b>Pass; prefer R2</b>: the best second-round call is meaningfully better than ordering the upcard.</li>
            </ul>
          </details>

          <div class="threshold-strip">
            <div class="stat">
              <span>hand score</span>
              <b id="scoreMetric">-</b>
              <small>Shape score from trump, bowers, aces, voids, and two-suitedness.</small>
            </div>
            <div class="stat">
              <span>call threshold</span>
              <b id="thresholdMetric">-</b>
              <small>Minimum expert-style score for this seat, round, and suit.</small>
            </div>
            <div class="stat">
              <span>margin</span>
              <b id="margin">-</b>
              <small>Hand score minus the threshold.</small>
            </div>
          </div>

          <div class="metric-grid">
            <div class="stat"><span>team points</span><b id="expected">-</b><small>Average points your team scores.</small></div>
            <div class="stat"><span>net points</span><b id="net">-</b><small>Team points minus opponent points.</small></div>
            <div class="stat"><span>make 3+ tricks</span><b id="make">-</b><small>Chance you avoid being euchred.</small></div>
            <div class="stat"><span>march rate</span><b id="march">-</b><small>Chance your team takes all five tricks.</small></div>
            <div class="stat"><span>euchre risk</span><b id="euchred">-</b><small>Chance defenders score two.</small></div>
            <div class="stat"><span>one-point rate</span><b id="one">-</b><small>Chance of making 3 or 4 tricks.</small></div>
          </div>

          <dl class="details">
            <div><dt>Seat</dt><dd id="rel">-</dd></div>
            <div><dt>Trump</dt><dd id="called">-</dd></div>
            <div><dt>Avg tricks</dt><dd id="tricks">-</dd></div>
            <div><dt>Four points</dt><dd id="four">-</dd></div>
            <div><dt>Auto-loner rate</dt><dd id="aloneRate">-</dd></div>
            <div><dt>Samples</dt><dd id="sampleCount">-</dd></div>
            <div><dt>Shape</dt><dd id="shape">-</dd></div>
            <div><dt>Threshold basis</dt><dd id="basis">-</dd></div>
          </dl>
        </section>
      </div>
    </div>
  </section>
<style is:global>
  .euchre-tool {
    max-width: 1180px;
  }

  .euchre-grid {
    display: grid;
    grid-template-columns: minmax(300px, 420px) minmax(0, 1fr);
    gap: 1.25rem;
    align-items: start;
  }

  .panel {
    background: var(--bg-elev);
    border: 1px solid var(--line);
    border-radius: 8px;
    padding: 1.2rem;
    box-shadow: 0 1px 2px rgba(16, 24, 40, .06);
  }

  .panel h3 {
    font-family: var(--font-display);
    margin-top: 0;
  }

  .field-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: .75rem;
  }

  .panel label {
    display: block;
    margin: .75rem 0 .3rem;
    color: var(--text-dim);
    font-weight: 700;
    font-size: .86rem;
  }

  .panel input,
  .panel select {
    width: 100%;
    min-height: 2.7rem;
    border: 1px solid var(--line-strong);
    border-radius: 6px;
    padding: .45rem .7rem;
    background: var(--bg);
  }

  .hint {
    margin: .35rem 0 0;
    color: var(--text-faint);
    font-size: .86rem;
  }

  .button-row {
    display: flex;
    gap: .75rem;
    margin-top: 1rem;
    flex-wrap: wrap;
  }

  .error {
    display: none;
    margin-top: .75rem;
    padding: .7rem .85rem;
    border: 1px solid rgba(236, 72, 153, .4);
    background: rgba(236, 72, 153, .08);
    color: #f9a8d4;
    border-radius: 6px;
  }

  .table-view {
    position: relative;
    min-height: 390px;
    margin-bottom: 1rem;
    overflow: hidden;
    border: 1px solid #0f5132;
    border-radius: 8px;
    background:
      radial-gradient(circle at 50% 45%, rgba(255,255,255,.11), transparent 24%),
      radial-gradient(circle at 50% 50%, #159447 0%, #0f7539 55%, #064521 100%);
    box-shadow: inset 0 0 54px rgba(0, 0, 0, .33);
  }

  .table-ring {
    position: absolute;
    inset: 54px 88px 70px;
    border: 1px solid rgba(255,255,255,.12);
    border-radius: 50%;
  }

  .seat {
    position: absolute;
    display: grid;
    gap: .35rem;
    justify-items: center;
    color: rgba(255,255,255,.94);
    text-shadow: 0 1px 2px rgba(0,0,0,.4);
    font-weight: 800;
  }

  .seat-top { top: 18px; left: 50%; transform: translateX(-50%); }
  .seat-left { top: 142px; left: 18px; }
  .seat-right { top: 142px; right: 18px; }
  .seat-bottom { bottom: 12px; left: 50%; transform: translateX(-50%); }

  .avatar {
    width: 54px;
    height: 54px;
    display: grid;
    place-items: center;
    border: 2px solid rgba(255,255,255,.75);
    border-radius: 8px;
    background: linear-gradient(135deg, #263238, #111827);
    color: #fff;
    font-size: .95rem;
  }

  .dealer-chip {
    display: inline-grid;
    place-items: center;
    width: 28px;
    height: 28px;
    margin-left: .35rem;
    border-radius: 50%;
    border: 3px solid #f8fafc;
    background: #111827;
    color: #fff;
    font-size: .78rem;
    vertical-align: middle;
  }

  .table-center {
    position: absolute;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%);
    display: grid;
    gap: .5rem;
    justify-items: center;
  }

  .kitty,
  .table-hand,
  .mini-backs {
    display: flex;
    gap: .45rem;
    align-items: center;
  }

  .mini-backs {
    gap: .2rem;
  }

  .turn-label {
    padding: .3rem .55rem;
    border-radius: 999px;
    background: rgba(255,255,255,.16);
    color: #f8fafc;
    font-size: .76rem;
    font-weight: 800;
  }

  .card,
  .card-back {
    width: 54px;
    height: 74px;
    border-radius: 7px;
    box-shadow: 0 2px 8px rgba(0,0,0,.18);
  }

  .card {
    display: grid;
    grid-template-rows: 1fr auto 1fr;
    align-items: center;
    justify-items: center;
    padding: 7px 5px;
    border: 1px solid #b8b1a4;
    background: #fffdf9;
    font-weight: 850;
  }

  .card .corner {
    width: 100%;
    color: var(--text-faint);
    font-size: .68rem;
    line-height: 1;
  }

  .card .rank {
    font-size: 1.1rem;
    line-height: 1;
  }

  .card .suit {
    font-family: Georgia, "Times New Roman", serif;
    font-size: 1.7rem;
    line-height: .9;
  }

  .red { color: #b42318; }
  .black { color: #101828; }

  .card-back {
    border: 1px solid #0f172a;
    background:
      linear-gradient(135deg, rgba(255,255,255,.16), transparent),
      repeating-linear-gradient(45deg, #1d4ed8 0 6px, #1e3a8a 6px 12px);
  }

  .table-hand .card {
    width: 48px;
    height: 66px;
    padding: 5px 4px;
  }

  .mini-backs .card-back {
    width: 24px;
    height: 34px;
    border-radius: 4px;
  }

  .recommendation,
  .scenario-card,
  .stat,
  .help-box {
    border: 1px solid var(--line);
    border-radius: 7px;
    background: var(--bg-elev);
  }

  .recommendation {
    margin-bottom: 1rem;
    padding: .9rem 1rem;
    border-left-width: 6px;
  }

  .recommendation.good { border-left-color: #22d3ee; }
  .recommendation.ok { border-left-color: #8b5cf6; }
  .recommendation.warn { border-left-color: #f59e0b; }
  .recommendation.bad { border-left-color: #ec4899; }

  .recommendation span {
    color: var(--text-faint);
    font-size: .75rem;
    font-weight: 800;
    letter-spacing: .04em;
    text-transform: uppercase;
  }

  .recommendation b {
    display: block;
    margin-top: .15rem;
    font-size: 1.75rem;
    line-height: 1.1;
  }

  .recommendation p {
    margin: .4rem 0 0;
    color: var(--text-dim);
  }

  .scenario-grid,
  .threshold-strip,
  .metric-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: .75rem;
    margin-bottom: 1rem;
  }

  .scenario-card {
    padding: .75rem;
  }

  .scenario-card h3 {
    margin: 0 0 .35rem;
    color: var(--text-dim);
    font-size: .86rem;
  }

  .scenario-card .call {
    margin-bottom: .45rem;
    font-size: 1.1rem;
    font-weight: 850;
  }

  .scenario-card dl,
  .details {
    margin: 0;
  }

  .scenario-card dl {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: .2rem .5rem;
    font-size: .8rem;
  }

  .scenario-card dt,
  .scenario-card dd,
  .details dt,
  .details dd {
    margin: 0;
  }

  .scenario-card dt,
  .details dt {
    color: var(--text-dim);
  }

  .scenario-card dd,
  .details dd {
    color: #1f2933;
    font-weight: 800;
    text-align: right;
  }

  .help-box {
    margin-bottom: 1rem;
    padding: .75rem 1rem;
    color: var(--text-dim);
  }

  .help-box summary {
    cursor: pointer;
    font-weight: 800;
  }

  .stat {
    padding: .75rem;
  }

  .stat span {
    display: block;
    color: var(--text-faint);
    font-size: .78rem;
    font-weight: 800;
  }

  .stat b {
    display: block;
    margin-top: .2rem;
    font-size: 1.55rem;
    line-height: 1.15;
  }

  .stat small {
    display: block;
    margin-top: .3rem;
    color: var(--text-faint);
    font-size: .72rem;
    line-height: 1.35;
  }

  .details {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: .4rem 1rem;
    padding-top: 1rem;
    border-top: 1px solid rgba(144, 131, 109, .35);
  }

  .details div {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: .45rem;
  }

  @media (max-width: 980px) {
    .euchre-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 640px) {
    .field-grid,
    .scenario-grid,
    .threshold-strip,
    .metric-grid,
    .details {
      grid-template-columns: 1fr;
    }

    .table-view {
      min-height: 320px;
    }

    .seat-left,
    .seat-right {
      top: 118px;
    }

    .table-hand {
      gap: .2rem;
    }

    .table-hand .card {
      width: 36px;
      height: 52px;
    }
  }
</style>

<script is:inline>
  const RANKS = "9TJQKA";
  const SUITS = "CDHS";
  const RED = new Set(["D", "H"]);
  const BLACK = new Set(["C", "S"]);
  const suitName = { C: "♣ Clubs", D: "♦ Diamonds", H: "♥ Hearts", S: "♠ Spades" };
  const suitSymbol = { C: "♣", D: "♦", H: "♥", S: "♠" };
  const rankName = { T: "10", J: "J", Q: "Q", K: "K", A: "A", "9": "9" };
  const $ = (id) => document.getElementById(id);

  function card(rank, suit) { return SUITS.indexOf(suit) * RANKS.length + RANKS.indexOf(rank); }
  function cardRank(c) { return RANKS[c % RANKS.length]; }
  function cardSuit(c) { return SUITS[Math.floor(c / RANKS.length)]; }
  function cardName(c) { return cardRank(c) + cardSuit(c); }
  function deck() { return SUITS.split("").flatMap(s => RANKS.split("").map(r => card(r, s))); }
  function sameColor(a, b) { return (RED.has(a) && RED.has(b)) || (BLACK.has(a) && BLACK.has(b)); }
  function nextSuit(s) { return { C: "S", S: "C", D: "H", H: "D" }[s]; }
  function team(seat) { return seat % 2; }
  function partner(seat) { return (seat + 2) % 4; }
  function leftOf(seat) { return (seat + 1) % 4; }
  function relSeat(seat, dealer) { return { 1: "eldest", 2: "dealer_partner", 3: "right_of_dealer", 0: "dealer" }[(seat - dealer + 4) % 4]; }
  function parseCard(text) {
    let t = text.trim().toUpperCase();
    if (t.startsWith("10")) t = "T" + t.slice(2);
    if (t.length !== 2 || !RANKS.includes(t[0]) || !SUITS.includes(t[1])) throw new Error(`Bad card: ${text}`);
    return card(t[0], t[1]);
  }
  function parseCards(text) { return text.replaceAll(",", " ").split(/\s+/).filter(Boolean).map(parseCard); }
  function handText(hand) { return [...hand].sort((a, b) => a - b).map(cardName).join(" "); }
  function effectiveSuit(c, trump) {
    const suit = cardSuit(c);
    return cardRank(c) === "J" && sameColor(suit, trump) ? trump : suit;
  }
  function isRight(c, trump) { return cardRank(c) === "J" && cardSuit(c) === trump; }
  function isLeft(c, trump) { return cardRank(c) === "J" && cardSuit(c) !== trump && sameColor(cardSuit(c), trump); }
  function trumpValue(c, trump) {
    if (isRight(c, trump)) return 12;
    if (isLeft(c, trump)) return 11;
    if (effectiveSuit(c, trump) !== trump) return 0;
    return { A: 10, K: 9, Q: 8, J: 7, T: 6, "9": 5 }[cardRank(c)];
  }
  function plainValue(c) { return { A: 6, K: 5, Q: 4, J: 3, T: 2, "9": 1 }[cardRank(c)]; }
  function trickPower(c, trump, led) {
    const eff = effectiveSuit(c, trump);
    if (eff === trump) return 200 + trumpValue(c, trump);
    if (eff === led) return 100 + plainValue(c);
    return plainValue(c);
  }
  function legalCards(hand, trump, led) {
    if (!led) return hand;
    const followers = hand.filter(c => effectiveSuit(c, trump) === led);
    return followers.length ? followers : hand;
  }
  function trickWinner(trick, trump) {
    const led = effectiveSuit(trick[0].card, trump);
    return trick.reduce((best, play) => trickPower(play.card, trump, led) > trickPower(best.card, trump, led) ? play : best).seat;
  }
  function nextActiveAfter(seat, active) {
    let nxt = leftOf(seat);
    while (!active.includes(nxt)) nxt = leftOf(nxt);
    return nxt;
  }
  function featuresFor(hand, trump) {
    const bySuit = Object.fromEntries(SUITS.split("").map(s => [s, []]));
    const trumps = [];
    hand.forEach(c => {
      const eff = effectiveSuit(c, trump);
      bySuit[eff].push(c);
      if (eff === trump) trumps.push(c);
    });
    const right = hand.some(c => isRight(c, trump)) ? 1 : 0;
    const left = hand.some(c => isLeft(c, trump)) ? 1 : 0;
    const trumpAce = hand.some(c => cardRank(c) === "A" && effectiveSuit(c, trump) === trump) ? 1 : 0;
    const offAces = hand.filter(c => cardRank(c) === "A" && effectiveSuit(c, trump) !== trump).length;
    const singletonAces = Object.entries(bySuit).filter(([s, cards]) => s !== trump && cards.length === 1 && cardRank(cards[0]) === "A").length;
    const voids = Object.entries(bySuit).filter(([s, cards]) => s !== trump && cards.length === 0).length;
    const suitsHeld = Object.values(bySuit).filter(cards => cards.length).length;
    const twoSuited = suitsHeld <= 2 ? 1 : 0;
    let strength = 0;
    hand.forEach(c => {
      if (effectiveSuit(c, trump) === trump) {
        if (isRight(c, trump)) strength += 3.4;
        else if (isLeft(c, trump)) strength += 2.8;
        else strength += { A: 2.1, K: 1.55, Q: 1.15, T: .85, "9": .65 }[cardRank(c)];
      } else if (cardRank(c) === "A") strength += 1.15;
      else if (cardRank(c) === "K") strength += .35;
    });
    strength += .55 * singletonAces + .35 * voids + .55 * twoSuited;
    if (trumps.length >= 3) strength += .55;
    if (trumps.length >= 4) strength += .85;
    return { trump_count: trumps.length, right, left, trump_ace: trumpAce, off_aces: offAces, singleton_aces: singletonAces, voids, suits_held: suitsHeld, two_suited: twoSuited, strength: Math.round(strength * 1000) / 1000 };
  }
  function bestDiscard(hand6, trump) {
    let best = null;
    hand6.forEach(discard => {
      const kept = hand6.filter(c => c !== discard);
      const feats = featuresFor(kept, trump);
      let score = feats.strength;
      if (effectiveSuit(discard, trump) !== trump) score += .15 * feats.voids;
      if (!best || score > best.score) best = { kept: kept.sort((a, b) => a - b), discard, score };
    });
    return best;
  }
  function wantsAlone(hand, caller, trump, score) {
    const feats = featuresFor(hand, trump);
    const myScore = score[team(caller)];
    const oppScore = score[1 - team(caller)];
    const urgent = [6, 7, 8, 9].includes(myScore) || oppScore >= 8;
    const hasBower = feats.right || feats.left;
    return (feats.right && feats.left && feats.trump_ace) ||
      (feats.trump_count >= 4 && hasBower && feats.off_aces >= 1) ||
      (urgent && feats.trump_count >= 3 && hasBower && feats.off_aces >= 2);
  }
  function chooseCardFast(hands, player, trick, trump, makerTeam) {
    const hand = hands[player];
    const led = trick.length ? effectiveSuit(trick[0].card, trump) : null;
    const legal = legalCards(hand, trump, led);
    const myTeam = team(player);
    if (!trick.length) {
      if (myTeam === makerTeam) {
        const trumps = legal.filter(c => effectiveSuit(c, trump) === trump);
        if (trumps.length) return trumps.sort((a, b) => trumpValue(b, trump) - trumpValue(a, trump))[0];
      }
      const aces = legal.filter(c => effectiveSuit(c, trump) !== trump && cardRank(c) === "A");
      if (aces.length) return aces.sort((a, b) => plainValue(b) - plainValue(a))[0];
      return legal.sort((a, b) => (effectiveSuit(a, trump) === trump) - (effectiveSuit(b, trump) === trump) || plainValue(a) - plainValue(b))[0];
    }
    const currentWinner = trickWinner(trick, trump);
    const currentCard = trick.find(p => p.seat === currentWinner).card;
    const currentPower = trickPower(currentCard, trump, led);
    const winning = legal.filter(c => trickPower(c, trump, led) > currentPower);
    if (team(currentWinner) === myTeam) return legal.sort((a, b) => trickPower(a, trump, led) - trickPower(b, trump, led))[0];
    if (winning.length) return winning.sort((a, b) => trickPower(a, trump, led) - trickPower(b, trump, led))[0];
    return legal.sort((a, b) => trickPower(a, trump, led) - trickPower(b, trump, led))[0];
  }
  function playHand(hands, dealer, caller, trump, alone) {
    const makerTeam = team(caller);
    const inactive = alone ? partner(caller) : null;
    const active = [0, 1, 2, 3].filter(s => s !== inactive);
    let leader = nextActiveAfter(dealer, active);
    const mutable = hands.map(h => [...h].sort((a, b) => a - b));
    let makerTricks = 0;
    for (let trickNo = 0; trickNo < 5; trickNo++) {
      const trick = [];
      let player = leader;
      while (trick.length < active.length) {
        const chosen = chooseCardFast(mutable, player, trick, trump, makerTeam);
        mutable[player] = mutable[player].filter(c => c !== chosen);
        trick.push({ seat: player, card: chosen });
        player = nextActiveAfter(player, active);
      }
      const winner = trickWinner(trick, trump);
      if (team(winner) === makerTeam) makerTricks++;
      leader = winner;
    }
    return makerTricks;
  }
  function scoreHand(caller, makerTricks, alone) {
    const points = [0, 0];
    const maker = team(caller);
    if (makerTricks < 3) points[1 - maker] = 2;
    else if (makerTricks === 5) points[maker] = alone ? 4 : 2;
    else points[maker] = 1;
    return points;
  }
  function shuffle(arr) {
    for (let i = arr.length - 1; i > 0; i--) {
      const j = Math.floor(Math.random() * (i + 1));
      [arr[i], arr[j]] = [arr[j], arr[i]];
    }
    return arr;
  }
  function completeKnownDeal(hand, seat, upcard) {
    const known = new Set([...hand, upcard]);
    if (known.size !== hand.length + 1) throw new Error("Hand and upcard must not contain duplicates.");
    const remaining = shuffle(deck().filter(c => !known.has(c)));
    const hands = [[], [], [], []];
    hands[seat] = [...hand].sort((a, b) => a - b);
    let cursor = 0;
    for (let p = 0; p < 4; p++) {
      if (p === seat) continue;
      hands[p] = remaining.slice(cursor, cursor + 5).sort((a, b) => a - b);
      cursor += 5;
    }
    return hands;
  }
  function playCalledHand(hands, dealer, caller, upcard, trump, roundNo, score, aloneChoice) {
    const mutable = hands.map(h => [...h]);
    if (roundNo === 1) {
      if (trump !== cardSuit(upcard)) throw new Error("Round 1 can only call the upcard suit.");
      mutable[dealer] = bestDiscard([...mutable[dealer], upcard].sort((a, b) => a - b), trump).kept;
    } else if (trump === cardSuit(upcard)) throw new Error("Round 2 cannot call the turned-down suit.");
    const alone = aloneChoice === null ? wantsAlone(mutable[caller], caller, trump, score) : aloneChoice;
    const makerTricks = playHand(mutable, dealer, caller, trump, alone);
    return { points: scoreHand(caller, makerTricks, alone), makerTricks, alone, finalHand: mutable[caller] };
  }
  function estimateCallOdds({ hand, seat, dealer, upcard, trump, roundNo, score, samples, aloneChoice }) {
    const points = { 0: 0, 1: 0, 2: 0, 4: 0 };
    let tricks = 0, aloneCount = 0, strength = 0, oppPoints = 0;
    for (let i = 0; i < samples; i++) {
      const hands = completeKnownDeal(hand, seat, upcard);
      const result = playCalledHand(hands, dealer, seat, upcard, trump, roundNo, score, aloneChoice);
      const maker = team(seat);
      const makerPoints = result.points[maker];
      points[makerPoints] = (points[makerPoints] || 0) + 1;
      oppPoints += result.points[1 - maker];
      tricks += result.makerTricks;
      aloneCount += result.alone ? 1 : 0;
      strength += featuresFor(result.finalHand, trump).strength;
    }
    const expected = Object.entries(points).reduce((sum, [p, n]) => sum + Number(p) * n, 0) / samples;
    const expectedOpp = oppPoints / samples;
    return {
      samples,
      expected_points: expected,
      expected_opponent_points: expectedOpp,
      expected_net_points: expected - expectedOpp,
      make_pct: 100 * ((points[1] || 0) + (points[2] || 0) + (points[4] || 0)) / samples,
      euchred_pct: 100 * (points[0] || 0) / samples,
      one_point_pct: 100 * (points[1] || 0) / samples,
      march_pct: 100 * ((points[2] || 0) + (points[4] || 0)) / samples,
      two_point_pct: 100 * (points[2] || 0) / samples,
      four_point_pct: 100 * (points[4] || 0) / samples,
      alone_pct: 100 * aloneCount / samples,
      avg_maker_tricks: tricks / samples,
      avg_strength: strength / samples,
      caller_rel: relSeat(seat, dealer),
    };
  }
  function callThresholdInfo(hand, seat, dealer, upcard, trump, roundNo) {
    const rel = relSeat(seat, dealer);
    const turned = cardSuit(upcard);
    let evalHand = hand, threshold, basis, adjustment = 0, exception = null;
    if (roundNo === 1) {
      if (trump !== turned) throw new Error("Round 1 can only call the upcard suit.");
      if (seat === dealer) {
        evalHand = bestDiscard([...hand, upcard].sort((a, b) => a - b), trump).kept;
        threshold = 4.25; basis = "dealer pickup threshold";
        if (cardRank(upcard) === "J") { threshold -= .6; adjustment = -.6; basis += "; jack pickup bonus"; }
      } else {
        threshold = { eldest: 5.7, dealer_partner: 4.75, right_of_dealer: 5.45 }[rel];
        basis = `round-one ${rel} threshold`;
        if (cardRank(upcard) === "J" && team(seat) !== team(dealer)) { threshold += .65; adjustment = .65; basis += "; ordering opponent into jack penalty"; }
      }
      const feats = featuresFor(evalHand, trump);
      return thresholdObject(feats.strength, feats, threshold, basis, adjustment, exception);
    }
    if (trump === turned) throw new Error("Round 2 cannot call the turned-down suit.");
    const feats = featuresFor(evalHand, trump);
    threshold = { eldest: 4.0, dealer_partner: 4.45, right_of_dealer: 4.8, dealer: 4.15 }[rel];
    let value = feats.strength;
    basis = `round-two ${rel} threshold`;
    if (trump === nextSuit(turned)) {
      adjustment = ["eldest", "right_of_dealer"].includes(rel) ? .85 : .25;
      value += adjustment; basis += adjustment === .85 ? "; next bonus" : "; soft next bonus";
    } else if (!sameColor(trump, turned)) {
      adjustment = ["dealer_partner", "dealer"].includes(rel) ? .45 : -.25;
      value += adjustment; basis += adjustment > 0 ? "; reverse-next/green bonus" : "; green caution";
    }
    if (trump === nextSuit(turned) && ["eldest", "right_of_dealer"].includes(rel)) {
      if (feats.trump_count >= 3) exception = "next with 3+ trump";
      else if (feats.trump_count >= 2 && feats.off_aces >= 1) exception = "next with 2 trump and an off ace";
      else if (feats.trump_count >= 1 && feats.off_aces >= 2) exception = "thin next with two off aces";
      else if (feats.off_aces >= 3) exception = "no-trump next with three off aces";
    }
    return thresholdObject(value, feats, threshold, basis, adjustment, exception);
  }
  function thresholdObject(value, feats, threshold, basis, adjustment, exception) {
    return {
      score: round(value, 3), raw_strength: feats.strength, threshold: round(threshold, 3), margin: round(value - threshold, 3),
      meets_threshold: value >= threshold || exception !== null, basis, adjustment: round(adjustment, 3), exception,
      trump_count: feats.trump_count, bowers: feats.right + feats.left, off_aces: feats.off_aces, two_suited: feats.two_suited, voids: feats.voids,
    };
  }
  function callVerdict(odds, threshold) {
    const expected = odds.expected_points, net = odds.expected_net_points, make = odds.make_pct, euchred = odds.euchred_pct;
    if (threshold.meets_threshold && expected >= 1.05 && net >= .75 && make >= 82) return verdict("Strong call", "good", "Above threshold with strong simulated point equity.");
    if (threshold.meets_threshold && expected >= .85 && net >= 0 && make >= 70) return verdict("Playable call", "ok", "Clears the model threshold, but the march upside is the difference-maker.");
    if (expected >= .95 && net >= .25 && make >= 78) return verdict("Stats like it", "ok", "Simulation is favorable even though the hand-score model is cautious.");
    if (euchred >= 35 || expected < .7 || net < -.25) return verdict("Avoid", "bad", "The set risk is too high for this call shape.");
    return verdict("Thin", "warn", "Close decision; score and table dynamics should steer it.");
  }
  function verdict(label, tone, reason) { return { label, tone, reason }; }
  function compactScenario(label, roundNo, trump, odds, threshold, verdict) {
    return { label, round: roundNo, trump, expected: odds.expected_points, net: odds.expected_net_points, make_pct: odds.make_pct, euchred_pct: odds.euchred_pct, march_pct: odds.march_pct, score: threshold.score, threshold: threshold.threshold, margin: threshold.margin, verdict };
  }
  function scenarioComparison(opts, selected) {
    const selectedCard = compactScenario("Selected call", opts.roundNo, opts.trump, selected.odds, selected.threshold, selected.verdict);
    const upSuit = cardSuit(opts.upcard);
    let upcardCard;
    if (opts.roundNo === 1 && opts.trump === upSuit) upcardCard = { ...selectedCard, label: "Call upcard now" };
    else {
      const upOpts = { ...opts, trump: upSuit, roundNo: 1 };
      const odds = estimateCallOdds(upOpts), threshold = callThresholdInfo(opts.hand, opts.seat, opts.dealer, opts.upcard, upSuit, 1), v = callVerdict(odds, threshold);
      upcardCard = compactScenario("Call upcard now", 1, upSuit, odds, threshold, v);
    }
    const r2 = SUITS.split("").filter(s => s !== upSuit).map(s => {
      const r2Opts = { ...opts, trump: s, roundNo: 2 };
      const odds = estimateCallOdds(r2Opts), threshold = callThresholdInfo(opts.hand, opts.seat, opts.dealer, opts.upcard, s, 2), v = callVerdict(odds, threshold);
      return compactScenario("Pass, then call", 2, s, odds, threshold, v);
    }).sort((a, b) => b.net - a.net || b.expected - a.expected);
    return { selected: selectedCard, upcard: upcardCard, best_round2: r2[0], round2_options: r2 };
  }
  function expertRecommendation(scenarios) {
    const s = scenarios.selected, r2 = scenarios.best_round2, up = scenarios.upcard;
    if (s.verdict.label === "Strong call" || (s.net >= .75 && s.make_pct >= 82)) return rec("CALL", "good", "This clears the threshold and the simulations show strong positive net points.");
    if (s.net >= .25 && s.make_pct >= 75 && s.euchred_pct < 25) return rec("CALL", "good", "The hand is not a lock, but the risk/reward is favorable enough to call.");
    if (r2.net > s.net + .2 && s.net < .35) return rec(`PASS; prefer R2 ${suitWord(r2.trump)} if available`, "warn", "Calling now is weaker than the best round-two line. Passing does not guarantee you get that chance.");
    if (s.net >= 0 && s.margin >= 0 && s.euchred_pct < 35) return rec("LEAN CALL", "ok", "This is playable but thin. You are relying on table position and avoiding a set.");
    if (s.net > -.25 && s.euchred_pct < 40) return rec("LEAN PASS", "warn", "This lives in the gray area, but the net value is not good enough to prefer calling.");
    if (up.net > s.net + .2) return rec("PASS", "bad", "The selected call has too much set risk and negative net value.");
    return rec("PASS", "bad", "Expert play would avoid this call: the simulations punish it too often.");
  }
  function rec(action, tone, reason) { return { action, tone, reason }; }
  function suitWord(s) { return { C: "Clubs", D: "Diamonds", H: "Hearts", S: "Spades" }[s]; }
  function round(n, digits = 2) { const p = 10 ** digits; return Math.round(n * p) / p; }
  function signed(n, digits = 2) { return `${n >= 0 ? "+" : ""}${Number(n).toFixed(digits)}`; }
  function pct(n) { return `${Number(n).toFixed(1)}%`; }
  function parseScore(text) {
    const parts = text.replace(":", "-").split("-");
    if (parts.length !== 2) throw new Error("Score must look like 0-0.");
    return [Number(parts[0]), Number(parts[1])];
  }
  function cardClass(code) { return ["H", "D"].includes(code.slice(-1)) ? "red" : "black"; }
  function cardMarkup(code, label = "") {
    const suit = code.slice(-1), rank = code.slice(0, -1);
    return `<div class="card ${cardClass(code)}" title="${code}"><div class="corner">${label}</div><div class="rank">${rankName[rank] || rank}</div><div class="suit">${suitSymbol[suit]}</div></div>`;
  }
  function cardBacks(count = 5) { return Array.from({ length: count }, () => `<div class="card-back"></div>`).join(""); }
  function seatLabel(seat, userSeat) { return seat === userSeat ? "You" : seat === (userSeat + 2) % 4 ? "Partner" : `Seat ${seat}`; }
  function renderSeat(position, seat, userSeat, dealer) {
    const chip = seat === dealer ? `<span class="dealer-chip">D</span>` : "";
    const avatar = seat === userSeat ? "YOU" : seat === (userSeat + 2) % 4 ? "P" : String(seat);
    const backs = position === "bottom" ? "" : `<div class="mini-backs">${cardBacks(5)}</div>`;
    return `<div class="seat seat-${position}"><div class="avatar">${avatar}</div><div>${seatLabel(seat, userSeat)}${chip}</div>${backs}</div>`;
  }
  function renderTable(handTextValue, upcardText, seat, dealer, trump) {
    const userSeat = Number(seat);
    const seats = { bottom: userSeat, left: (userSeat + 1) % 4, top: (userSeat + 2) % 4, right: (userSeat + 3) % 4 };
    const handMarkup = handTextValue.split(" ").filter(Boolean).map(cardMarkup).join("");
    $("tableView").innerHTML = `
      <div class="table-ring"></div>
      ${renderSeat("top", seats.top, userSeat, Number(dealer))}
      ${renderSeat("left", seats.left, userSeat, Number(dealer))}
      ${renderSeat("right", seats.right, userSeat, Number(dealer))}
      <div class="table-center">
        <div class="turn-label">Upcard ${suitName[upcardText.slice(-1)]}</div>
        <div class="kitty"><div class="card-back"></div>${cardMarkup(upcardText, "up")}</div>
        <div class="turn-label">Considering ${suitName[trump]}</div>
      </div>
      <div class="seat seat-bottom"><div class="table-hand">${handMarkup}</div><div>You${userSeat === Number(dealer) ? `<span class="dealer-chip">D</span>` : ""}</div></div>`;
  }
  function renderScenario(id, scenario) {
    $(id).innerHTML = `<h3>${scenario.label}</h3><div class="call">R${scenario.round} ${suitName[scenario.trump]}</div><dl>
      <dt>verdict</dt><dd>${scenario.verdict.label}</dd><dt>net</dt><dd>${signed(scenario.net)}</dd>
      <dt>team pts</dt><dd>${Number(scenario.expected).toFixed(3)}</dd><dt>make</dt><dd>${pct(scenario.make_pct)}</dd>
      <dt>euchred</dt><dd>${pct(scenario.euchred_pct)}</dd><dt>margin</dt><dd>${signed(scenario.margin)}</dd></dl>`;
  }
  function readOptions() {
    const hand = parseCards($("hand").value);
    if (hand.length !== 5) throw new Error("Enter exactly five cards.");
    if (new Set(hand).size !== 5) throw new Error("Your hand contains duplicates.");
    const upcard = parseCard($("upcard").value);
    if (hand.includes(upcard)) throw new Error("The upcard cannot also be in your hand.");
    const score = parseScore($("score").value);
    const aloneValue = $("alone").value;
    const aloneChoice = aloneValue === "auto" ? null : aloneValue === "yes";
    const samples = Math.max(100, Math.min(Number($("samples").value || 5000), 50000));
    return { hand, seat: Number($("seat").value), dealer: Number($("dealer").value), upcard, trump: $("trump").value, roundNo: Number($("round").value), score, samples, aloneChoice };
  }
  function runOdds() {
    $("error").style.display = "none";
