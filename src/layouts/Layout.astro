---
import Icon from "../components/Icon.astro";
import "../styles/main.css";

interface Props {
  title: string;
  description?: string;
  bodyClass?: string;
}

const {
  title,
  description = "Flow Cytometry Resources by Howie Seay",
  bodyClass = "",
} = Astro.props;

const path = Astro.url.pathname.replace(/\/$/, "") || "/";

const links = [
  { href: "/", label: "Home" },
  { href: "/flowsites", label: "Flow Resources" },
  { href: "/euchre", label: "Euchre Odds" },
  { href: "/cv", label: "Curriculum Vitae" },
  { href: "/pubs", label: "Publications" },
];

const social = [
  { href: "https://www.facebook.com/thisishowwesee/", icon: "facebook", label: "Facebook" },
  { href: "https://twitter.com/HowieSeay", icon: "twitter", label: "Twitter" },
  { href: "https://www.linkedin.com/in/this-is-how-we-see/", icon: "linkedin", label: "LinkedIn" },
] as const;
---

<!doctype html>
<html lang="en">
  <head>
    <title>{title}</title>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Raleway:wght@400;500;700&display=swap"
    />
  </head>
  <body class:list={["is-loading", bodyClass]}>
    <a class="skip-link" href="#content">Skip to content</a>

    <header id="header" class:list={[{ alt: bodyClass === "landing" }]}>
      <h1><a href="/">this.is.how.we.see</a></h1>
      <button type="button" class="nav-toggle" aria-expanded="false" aria-controls="nav">
        <Icon name="bars" />
        <span>Menu</span>
      </button>
    </header>

    <nav id="nav" aria-label="Main">
      <button type="button" class="nav-close" aria-label="Close menu">
        <Icon name="times" />
      </button>
      <ul class="links">
        {
          links.map((link) => (
            <li class:list={[{ active: path === link.href }]}>
              <a href={link.href} aria-current={path === link.href ? "page" : undefined}>
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="nav-backdrop"></div>

    <main id="content">
      <slot />
    </main>

    <footer id="footer">
      <div class="inner">
        <ul class="icons">
          {
            social.map((item) => (
              <li>
                <a href={item.href} target="_blank" rel="noopener noreferrer" class="icon">
                  <Icon name={item.icon} />
                  <span class="label">{item.label}</span>
                </a>
              </li>
            ))
          }
        </ul>
        <ul class="copyright">
          <li>&copy; SEAYCORP.</li>
          <li>Images: <a href="https://unsplash.com">Unsplash</a>.</li>
          <li>Design: <a href="https://templated.co">TEMPLATED</a>.</li>
        </ul>
      </div>
    </footer>

    <script>
      const nav = document.getElementById("nav");
      const toggle = document.querySelector<HTMLButtonElement>(".nav-toggle");
      const close = document.querySelector<HTMLButtonElement>(".nav-close");
      const backdrop = document.querySelector<HTMLElement>(".nav-backdrop");

      function setNav(open: boolean) {
        if (!nav || !toggle || !backdrop) return;
        nav.classList.toggle("visible", open);
        backdrop.classList.toggle("visible", open);
        toggle.setAttribute("aria-expanded", String(open));
        document.body.style.overflow = open ? "hidden" : "";
        if (open) {
          close?.focus();
        } else {
          toggle.focus();
        }
      }

      toggle?.addEventListener("click", () => setNav(!nav?.classList.contains("visible")));
      close?.addEventListener("click", () => setNav(false));
      backdrop?.addEventListener("click", () => setNav(false));

      document.addEventListener("keydown", (event) => {
        if (event.key === "Escape" && nav?.classList.contains("visible")) setNav(false);
      });

      // Close the panel when a link is followed.
      nav?.querySelectorAll("a").forEach((link) => {
        link.addEventListener("click", () => setNav(false));
      });

      // Re-enable transitions once the page has settled.
      window.addEventListener("load", () => {
        window.setTimeout(() => document.body.classList.remove("is-loading"), 100);
      });
    </script>
  </body>
</html>
