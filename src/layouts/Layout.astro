---
import Icon from "../components/Icon.astro";
import "../styles/main.css";

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = "Howie Seay. Product leadership in flow cytometry, spectral analysis, and automated cell therapy manufacturing.",
} = Astro.props;

const path = Astro.url.pathname.replace(/\/$/, "") || "/";

const links = [
  { href: "/", label: "Home" },
  { href: "/flowsites", label: "Flow Resources" },
  { href: "/compensation", label: "Compensation" },
  { href: "/cv", label: "CV" },
  { href: "/pubs", label: "Publications" },
  { href: "/euchre", label: "Euchre" },
];

const social = [
  { href: "https://www.linkedin.com/in/this-is-how-we-see/", icon: "linkedin", label: "LinkedIn" },
  { href: "https://twitter.com/HowieSeay", icon: "twitter", label: "Twitter" },
  { href: "https://www.facebook.com/thisishowwesee/", icon: "facebook", label: "Facebook" },
] as const;

const year = 2026;
---

<!doctype html>
<html lang="en">
  <head>
    <title>{title}</title>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#0a0c10" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;700&family=Inter:wght@400;600&family=IBM+Plex+Mono:wght@400;500&display=swap"
    />
  </head>
  <body>
    <a class="skip-link" href="#content">Skip to content</a>

    <header id="header">
      <div class="container">
        <a class="wordmark" href="/">
          <span class="wm-lead">this.is.</span><span class="wm-key">how.we.see</span>
        </a>

        <nav aria-label="Main">
          <ul class="nav-links">
            {
              links.map((link) => (
                <li>
                  <a href={link.href} aria-current={path === link.href ? "page" : undefined}>
                    {link.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>

        <button type="button" class="nav-toggle" aria-expanded="false" aria-controls="nav-panel">
          <Icon name="bars" />
          <span class="visually-hidden">Menu</span>
        </button>
      </div>
    </header>

    <nav id="nav-panel" class="nav-panel" aria-label="Main">
      <button type="button" class="nav-close" aria-label="Close menu">
        <Icon name="times" />
      </button>
      {
        links.map((link) => (
          <a href={link.href} aria-current={path === link.href ? "page" : undefined}>
            {link.label}
          </a>
        ))
      }
    </nav>
    <div class="nav-backdrop"></div>

    <main id="content">
      <slot />
    </main>

    <footer id="footer">
      <div class="container inner">
        <p class="colophon">&copy; {year} Howie Seay &middot; Rogue Valley, Oregon</p>
        <ul class="icons">
          {
            social.map((item) => (
              <li>
                <a href={item.href} target="_blank" rel="noopener noreferrer">
                  <Icon name={item.icon} />
                  <span class="label">{item.label}</span>
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </footer>

    <script>
      const panel = document.getElementById("nav-panel");
      const toggle = document.querySelector<HTMLButtonElement>(".nav-toggle");
      const close = document.querySelector<HTMLButtonElement>(".nav-close");
      const backdrop = document.querySelector<HTMLElement>(".nav-backdrop");

      function setNav(open: boolean) {
        if (!panel || !toggle || !backdrop) return;
        panel.classList.toggle("visible", open);
        backdrop.classList.toggle("visible", open);
        toggle.setAttribute("aria-expanded", String(open));
        document.body.style.overflow = open ? "hidden" : "";
        // visibility flips instantly on open (see .nav-panel.visible), so the
        // close button is focusable synchronously — no rAF needed
        if (open) close?.focus();
        else toggle.focus();
      }

      toggle?.addEventListener("click", () => setNav(!panel?.classList.contains("visible")));
      close?.addEventListener("click", () => setNav(false));
      backdrop?.addEventListener("click", () => setNav(false));
      panel?.querySelectorAll("a").forEach((a) => a.addEventListener("click", () => setNav(false)));

      document.addEventListener("keydown", (event) => {
        if (event.key === "Escape" && panel?.classList.contains("visible")) setNav(false);
      });
    </script>
  </body>
</html>
