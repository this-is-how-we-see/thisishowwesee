---
import Icon from "../components/Icon.astro";
import "../styles/main.css";

interface Props {
  title: string;
  description?: string;
  noindex?: boolean;
  /** Path to the social-share image, relative to the site root. */
  image?: string;
  /** JSON-LD graph nodes for this page, merged into the site-wide graph. */
  schema?: Record<string, unknown>[];
}

const {
  title,
  description = "How We See LLC. Product development consulting from Howie Seay: discovery, strategy, roadmaps, pricing, and fractional product leadership.",
  noindex = false,
  image = "/images/banner.jpg",
  schema = [],
} = Astro.props;

const path = Astro.url.pathname.replace(/\/$/, "") || "/";

// Astro.site is set in astro.config.mjs; the fallback keeps `astro dev` honest
// if it is ever unset rather than emitting a relative canonical.
const site = Astro.site ?? new URL("https://thisishowwesee.com");
const canonical = new URL(path, site);
const socialImage = new URL(image, site);

// Everything a page passes in rides alongside the two nodes that describe the
// practice and the person, so search engines see one connected graph per page.
const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "ProfessionalService",
      "@id": `${site.origin}/#business`,
      name: "How We See LLC",
      alternateName: "How We See",
      url: `${site.origin}/`,
      email: "howie@thisishowwesee.com",
      description:
        "Product development consulting: discovery, requirements, business cases, pricing, roadmaps, and fractional product leadership, with unusual depth in technical and regulated products.",
      founder: { "@id": `${site.origin}/#howie` },
      areaServed: "Worldwide",
      address: {
        "@type": "PostalAddress",
        addressRegion: "OR",
        addressCountry: "US",
      },
      knowsAbout: [
        "Product development",
        "Product management",
        "Product strategy",
        "Requirements engineering",
        "Product roadmapping",
        "Pricing strategy",
        "Voice of customer research",
        "Fractional product leadership",
        "Scientific instruments",
        "Flow cytometry",
        "Spectral flow cytometry",
        "Cell therapy manufacturing",
        "GMP automation",
        "Regulated product development",
      ],
    },
    {
      "@type": "Person",
      "@id": `${site.origin}/#howie`,
      name: "Howie Seay",
      honorificSuffix: "SCYM(ASCP)",
      url: `${site.origin}/about`,
      email: "howie@thisishowwesee.com",
      jobTitle: "Innovative product development specialist",
      worksFor: { "@id": `${site.origin}/#business` },
      sameAs: [
        "https://www.linkedin.com/in/this-is-how-we-see/",
        "https://twitter.com/HowieSeay",
        "https://www.facebook.com/thisishowwesee/",
      ],
    },
    ...schema,
  ],
};

const links = [
  { href: "/", label: "Consulting" },
  { href: "/about", label: "About" },
  { href: "/flowsites", label: "Flow Resources" },
  { href: "/compensation", label: "Compensation" },
  { href: "/cv", label: "CV" },
  { href: "/pubs", label: "Publications" },
  { href: "/euchre", label: "Euchre" },
];

const social = [
  { href: "https://www.linkedin.com/in/this-is-how-we-see/", icon: "linkedin", label: "LinkedIn" },
  { href: "https://twitter.com/HowieSeay", icon: "twitter", label: "Twitter" },
  { href: "https://www.facebook.com/thisishowwesee/", icon: "facebook", label: "Facebook" },
] as const;

const year = 2026;
---

<!doctype html>
<html lang="en">
  <head>
    <title>{title}</title>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    {!noindex && <link rel="canonical" href={canonical.href} />}

    <meta property="og:type" content={path === "/" ? "website" : "article"} />
    <meta property="og:site_name" content="How We See LLC" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:image" content={socialImage.href} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@HowieSeay" />
    <meta name="twitter:creator" content="@HowieSeay" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage.href} />

    {!noindex && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}

    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#0a0c10" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;700&family=Inter:wght@400;600&family=IBM+Plex+Mono:wght@400;500&display=swap"
    />
  </head>
  <body>
    <a class="skip-link" href="#content">Skip to content</a>

    <header id="header">
      <div class="container">
        <a class="wordmark" href="/">
          <span class="wm-lead">this.is.</span><span class="wm-key">how.we.see</span>
        </a>

        <nav aria-label="Main">
          <ul class="nav-links">
            {
              links.map((link) => (
                <li>
                  <a href={link.href} aria-current={path === link.href ? "page" : undefined}>
                    {link.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>

        <button type="button" class="nav-toggle" aria-expanded="false" aria-controls="nav-panel">
          <Icon name="bars" />
          <span class="visually-hidden">Menu</span>
        </button>
      </div>
    </header>

    <nav id="nav-panel" class="nav-panel" aria-label="Main">
      <button type="button" class="nav-close" aria-label="Close menu">
        <Icon name="times" />
      </button>
      {
        links.map((link) => (
          <a href={link.href} aria-current={path === link.href ? "page" : undefined}>
            {link.label}
          </a>
        ))
      }
    </nav>
    <div class="nav-backdrop"></div>

    <main id="content">
      <slot />
    </main>

    <footer id="footer">
      <div class="container inner">
        <p class="colophon">&copy; {year} Howie Seay &middot; Rogue Valley, Oregon</p>
        <ul class="icons">
          {
            social.map((item) => (
              <li>
                <a href={item.href} target="_blank" rel="noopener noreferrer">
                  <Icon name={item.icon} />
                  <span class="label">{item.label}</span>
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </footer>

    <script>
      const panel = document.getElementById("nav-panel");
      const toggle = document.querySelector<HTMLButtonElement>(".nav-toggle");
      const close = document.querySelector<HTMLButtonElement>(".nav-close");
      const backdrop = document.querySelector<HTMLElement>(".nav-backdrop");

      function setNav(open: boolean) {
        if (!panel || !toggle || !backdrop) return;
        panel.classList.toggle("visible", open);
        backdrop.classList.toggle("visible", open);
        toggle.setAttribute("aria-expanded", String(open));
        document.body.style.overflow = open ? "hidden" : "";
        // visibility flips instantly on open (see .nav-panel.visible), so the
        // close button is focusable synchronously — no rAF needed
        if (open) close?.focus();
        else toggle.focus();
      }

      toggle?.addEventListener("click", () => setNav(!panel?.classList.contains("visible")));
      close?.addEventListener("click", () => setNav(false));
      backdrop?.addEventListener("click", () => setNav(false));
      panel?.querySelectorAll("a").forEach((a) => a.addEventListener("click", () => setNav(false)));

      document.addEventListener("keydown", (event) => {
        if (event.key === "Escape" && panel?.classList.contains("visible")) setNav(false);
      });
    </script>
  </body>
</html>
