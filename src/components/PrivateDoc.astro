---
/**
 * Google-gated private document.
 *
 * The content is NOT in this page, and it is not in this repo. It lives in a
 * private Vercel Blob and arrives from /api/private-doc, which hands it over
 * only after Google verifies the reader and the email matches ALLOWED_EMAILS.
 * Publish or update a document with:
 *
 *   npm run publish-private
 *
 * This replaced a 4-digit passcode over a public AES-GCM payload. That gate
 * kept the document from casual discovery and nothing more: the ciphertext was
 * committed to a public repo, so the passcode was the only work an attacker
 * had to do, and 10,000 candidates is about two seconds on a GPU.
 *
 * Pages that use this belong out of the nav in Layout.astro, and noindexed.
 */
interface Props {
  /** Must match a key in the DOCS table in api/private-doc.mjs. */
  slug: string;
  /** Small label above the sign-in heading. */
  eyebrow?: string;
}

const { slug, eyebrow = "Private" } = Astro.props;
---

<div class="gate" id="gate">
  <div class="gate-inner">
    <p class="gate-eyebrow">{eyebrow}</p>
    <h1 class="gate-title">Sign in to read this</h1>
    <p class="gate-sub">Use the Google account Howie invited. Ask him if you need access.</p>

    <div class="gate-signin" id="gsiButton"></div>

    <p class="gate-status" id="status" role="status" aria-live="polite"></p>
  </div>
</div>

<div class="doc-wrap" id="docWrap" data-slug={slug} hidden>
  <p class="whoami">
    <span id="whoamiEmail"></span>
    <button type="button" id="signOut">Sign out</button>
  </p>
  <article class="plan-doc" id="doc"></article>
</div>

<script src="https://accounts.google.com/gsi/client" async defer is:inline></script>

<style is:global>
  /* ---------- Gate ---------- */

  .gate {
    min-height: 68vh;
    display: grid;
    place-items: center;
    padding: clamp(3rem, 8vw, 6rem) var(--gutter);
  }

  .gate-inner {
    width: 100%;
    max-width: 22rem;
    text-align: center;
  }

  .gate-eyebrow {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--cyan);
    margin-bottom: 0.85rem;
  }

  .gate-title {
    font-family: var(--font-display);
    font-size: 1.6rem;
    font-weight: 500;
    letter-spacing: -0.01em;
    margin-bottom: 0.4rem;
  }

  .gate-sub {
    color: var(--text-dim);
    font-size: 0.92rem;
    margin-bottom: 2rem;
  }

  /* Google renders its own button in here, so this only has to centre it. */
  .gate-signin {
    display: flex;
    justify-content: center;
    min-height: 2.5rem;
  }

  .gate-signin button {
    background: var(--bg-elev);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    color: var(--text);
    font-family: var(--font-mono);
    font-size: 0.85rem;
    padding: 0.7rem 1.2rem;
    cursor: pointer;
    transition: background-color var(--ease), border-color var(--ease);
  }

  .gate-signin button:hover {
    background: var(--bg-elev-2);
    border-color: var(--line-strong);
  }

  /* Google's own button.
     It arrives as real DOM in this page, not inside an iframe — the iframe the
     library also creates is 0x0 and only carries messages — so its surfaces can
     be repainted here. Left alone, the variant Google shows to someone already
     signed in ("Sign in as Howie", with the avatar and address) is a white card,
     which reads as a hole punched in a dark page.
     Only the surface changes. Google keeps its own type, spacing and logo, and
     the small white circle the G sits on stays, because Google's branding asks
     for it. An inset shadow draws the hairline so the box never grows. */
  .gate-signin [role="button"] {
    background-color: var(--bg-elev) !important;
    box-shadow: inset 0 0 0 1px var(--line) !important;
    transition: background-color var(--ease);
  }
  .gate-signin [role="button"]:hover {
    background-color: var(--bg-elev-2) !important;
    box-shadow: inset 0 0 0 1px var(--line-strong) !important;
  }
  .gate-signin [role="button"] :is(span, div) {
    color: var(--text) !important;
  }

  /* The variant Google shows to a reader who is already signed in — "Sign in as
     Howie", with the avatar and address — arrives in its own iframe instead, so
     none of the rules above can reach it. That iframe is 20px wider and 4px
     taller than the chip it draws, and Google pulls the surplus back with a
     negative margin, which makes it bleed rather than layout. Google paints the
     bleed white, and on a dark page it reads as a card sitting behind the chip.
     Clipping the wrapper removes it. The wrapper is the box Google itself sizes
     to the chip, so no measurement is repeated here to go stale later. */
  .gate-signin > div {
    overflow: hidden;
    border-radius: 999px;
  }

  .gate-status {
    margin-top: 1.75rem;
    min-height: 1.4em;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.04em;
    color: var(--text-faint);
  }

  .gate-status.is-error {
    color: #fb7185;
  }

  /* ---------- Signed-in strip ---------- */

  .whoami {
    max-width: 54rem;
    margin: 0 auto;
    padding: 1.5rem var(--gutter) 0;
    display: flex;
    justify-content: flex-end;
    align-items: baseline;
    gap: 0.9rem;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.04em;
    color: var(--text-faint);
  }

  .whoami button {
    background: none;
    border: none;
    padding: 0;
    font: inherit;
    color: var(--cyan);
    cursor: pointer;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  /* ---------- Plan document ---------- */

  .plan-doc {
    --p-accent: var(--cyan);
    --p-good: #4ade80;
    --p-warn: #f59e0b;
    --p-bad: #fb7185;

    max-width: 54rem;
    margin: 0 auto;
    padding: clamp(2.5rem, 6vw, 4.5rem) var(--gutter) 6rem;
    font-size: 1rem;
    line-height: 1.68;
    color: var(--text);
  }

  .plan-doc p,
  .plan-doc ul,
  .plan-doc ol {
    max-width: var(--measure);
  }

  .plan-doc p { margin-bottom: 1rem; }
  .plan-doc ul, .plan-doc ol { margin-bottom: 1rem; padding-left: 1.3em; }
  .plan-doc li { margin-bottom: 0.45rem; }
  .plan-doc strong { color: var(--text); font-weight: 600; }
  .plan-doc em { font-style: italic; color: var(--text); }

  .plan-doc .plan-head {
    padding-bottom: 2.5rem;
    border-bottom: 1px solid var(--line-strong);
  }

  .plan-doc .eyebrow,
  .plan-doc .sec-label {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--p-accent);
    margin-bottom: 0.75rem;
  }

  .plan-doc h1 {
    font-family: var(--font-display);
    font-size: clamp(2rem, 5vw, 2.9rem);
    font-weight: 700;
    line-height: 1.08;
    letter-spacing: -0.02em;
    text-wrap: balance;
    margin-bottom: 1rem;
  }

  .plan-doc h2 {
    font-family: var(--font-display);
    font-size: clamp(1.4rem, 3vw, 1.85rem);
    font-weight: 500;
    line-height: 1.2;
    letter-spacing: -0.01em;
    text-wrap: balance;
    margin-bottom: 1rem;
  }

  .plan-doc h3 {
    font-family: var(--font-display);
    font-size: 1.15rem;
    font-weight: 500;
    margin: 2.25rem 0 0.6rem;
  }

  .plan-doc .dek {
    font-size: 1.08rem;
    color: var(--text-dim);
    max-width: 42em;
    margin-bottom: 1.5rem;
  }

  .plan-doc .lede {
    font-size: 1.06rem;
    color: var(--text-dim);
  }

  .plan-doc .byline {
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem 1.4rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--text-faint);
    max-width: none;
  }

  .plan-doc section { margin-top: 4rem; }

  /* at-a-glance */
  .plan-doc .glance {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(11rem, 1fr));
    gap: 1px;
    background: var(--line);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    overflow: hidden;
    margin-top: 2.5rem;
  }

  .plan-doc .glance > div {
    background: var(--bg-elev);
    padding: 1rem 1.1rem;
  }

  .plan-doc .glance .k {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-faint);
    margin-bottom: 0.4rem;
  }

  .plan-doc .glance .v {
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--p-accent);
    line-height: 1.1;
    font-variant-numeric: tabular-nums;
    margin-bottom: 0.25rem;
  }

  .plan-doc .glance .s {
    font-size: 0.78rem;
    color: var(--text-dim);
    line-height: 1.4;
    margin: 0;
  }

  /* legend */
  .plan-doc .legend {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.6rem 1.35rem;
    margin-top: 1.5rem;
    padding: 0.9rem 1.1rem;
    background: var(--bg-elev);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    font-size: 0.82rem;
    color: var(--text-dim);
    max-width: none;
  }

  .plan-doc .legend > strong {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-faint);
    font-weight: 500;
  }

  .plan-doc .legend .li {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .plan-doc .hl { color: var(--p-accent); }

  /* confidence chips */
  .plan-doc .chip {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 0.6rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    font-weight: 500;
    padding: 0.15rem 0.45rem;
    border-radius: 3px;
    white-space: nowrap;
    vertical-align: 0.1em;
  }

  .plan-doc .c-meas { background: rgba(74, 222, 128, 0.14); color: var(--p-good); }
  .plan-doc .c-der { background: rgba(242, 245, 247, 0.08); color: var(--text-dim); }
  .plan-doc .c-assum { background: rgba(245, 158, 11, 0.14); color: var(--p-warn); }

  .plan-doc .tag {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.08em;
    padding: 0.1rem 0.45rem;
    border-radius: 3px;
    background: rgba(34, 211, 238, 0.12);
    color: var(--cyan);
    white-space: nowrap;
  }

  /* tables */
  .plan-doc .tbl-wrap {
    overflow-x: auto;
    margin: 1.4rem 0 1.6rem;
    border: 1px solid var(--line);
    border-radius: var(--radius);
  }

  .plan-doc table {
    border-collapse: collapse;
    width: 100%;
    font-size: 0.86rem;
    background: var(--bg-elev);
  }

  .plan-doc th {
    text-align: left;
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    font-weight: 500;
    color: var(--text-faint);
    padding: 0.7rem 0.95rem;
    background: var(--bg-elev-2);
    border-bottom: 1px solid var(--line-strong);
    white-space: nowrap;
  }

  .plan-doc td {
    padding: 0.65rem 0.95rem;
    border-bottom: 1px solid var(--line);
    vertical-align: top;
    line-height: 1.5;
  }

  .plan-doc tbody tr:last-child td { border-bottom: none; }

  .plan-doc td.num,
  .plan-doc th.num {
    text-align: right;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  .plan-doc td .sub {
    display: block;
    font-size: 0.76rem;
    color: var(--text-faint);
    margin-top: 0.15rem;
  }

  .plan-doc tfoot td {
    font-weight: 600;
    background: var(--bg-elev-2);
    border-top: 1px solid var(--line-strong);
    border-bottom: none;
  }

  /* funnel */
  .plan-doc .funnel {
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
    margin: 1.75rem 0 0.5rem;
  }

  .plan-doc .frow {
    display: grid;
    grid-template-columns: 4.5rem 1fr;
    gap: 1rem;
    align-items: center;
  }

  .plan-doc .flabel {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    color: var(--text-faint);
    text-align: right;
  }

  .plan-doc .fbar {
    height: 2.9rem;
    border-radius: var(--radius);
    display: flex;
    align-items: center;
    padding: 0 0.9rem;
    min-width: min-content;
  }

  .plan-doc .fbar .fv {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 0.95rem;
    color: var(--bg);
    white-space: nowrap;
  }

  .plan-doc .w-100 { width: 100%; background: var(--cyan); }
  .plan-doc .w-46 { width: 46%; background: var(--violet); }
  .plan-doc .w-22 { width: 22%; background: var(--magenta); }

  .plan-doc .fnote {
    grid-column: 2;
    font-size: 0.78rem;
    color: var(--text-faint);
    margin: 0.35rem 0 0;
  }

  /* expandable math */
  .plan-doc details.math {
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--bg-elev);
    margin: 1.4rem 0 1.6rem;
    overflow: hidden;
  }

  .plan-doc details.math > summary {
    list-style: none;
    cursor: pointer;
    padding: 0.7rem 1rem;
    background: var(--bg-elev-2);
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--p-accent);
    display: flex;
    align-items: center;
    gap: 0.65rem;
    flex-wrap: wrap;
  }

  .plan-doc details.math > summary::-webkit-details-marker { display: none; }

  .plan-doc details.math > summary::before {
    content: "+";
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1rem;
    height: 1rem;
    border: 1px solid currentColor;
    border-radius: 2px;
    font-size: 0.75rem;
    line-height: 1;
    flex-shrink: 0;
  }

  .plan-doc details.math[open] > summary::before { content: "–"; }
  .plan-doc details.math > summary:hover { color: var(--text); }

  .plan-doc details.math > summary:focus-visible {
    outline: 2px solid var(--cyan);
    outline-offset: -2px;
  }

  .plan-doc .math-body {
    padding: 1.1rem 1rem 0.4rem;
    border-top: 1px solid var(--line);
  }

  .plan-doc .math-body p,
  .plan-doc .math-body ul {
    max-width: none;
    font-size: 0.92rem;
  }

  .plan-doc .ledger {
    display: grid;
    grid-template-columns: 1fr auto;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    margin: 1rem 0 1.1rem;
    border-top: 1px solid var(--line);
  }

  .plan-doc .ledger > div {
    padding: 0.5rem 0;
    border-bottom: 1px solid var(--line);
    line-height: 1.45;
  }

  .plan-doc .ledger .ll { color: var(--text-dim); padding-right: 1.25rem; }

  .plan-doc .ledger .lv {
    text-align: right;
    font-variant-numeric: tabular-nums;
    color: var(--text);
    white-space: nowrap;
  }

  .plan-doc .ledger .sum {
    color: var(--p-accent);
    font-weight: 500;
    border-bottom-color: var(--line-strong);
  }

  .plan-doc .ledger .op { color: var(--p-accent); }

  .plan-doc .src {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    line-height: 1.55;
    color: var(--text-faint);
    max-width: none;
  }

  .plan-doc .src b { color: var(--text-dim); font-weight: 500; }

  /* callout */
  .plan-doc .callout {
    border: 1px solid var(--line);
    border-left: 2px solid var(--p-accent);
    border-radius: 0 var(--radius) var(--radius) 0;
    background: var(--bg-elev);
    padding: 1.1rem 1.25rem;
    margin: 1.5rem 0;
  }

  .plan-doc .callout p:last-child { margin-bottom: 0; }

  .plan-doc .co-title {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--p-accent);
    margin-bottom: 0.6rem;
  }

  /* lab flow */
  .plan-doc .flow {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem;
    margin: 1.4rem 0 1.6rem;
  }

  .plan-doc .step {
    flex: 1 1 10rem;
    min-width: 10rem;
    background: var(--bg-elev);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 0.85rem 0.95rem;
  }

  .plan-doc .step .n {
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--p-accent);
    margin-bottom: 0.35rem;
  }

  .plan-doc .step .t {
    font-weight: 600;
    font-size: 0.9rem;
    line-height: 1.3;
    margin-bottom: 0.25rem;
  }

  .plan-doc .step .d {
    font-size: 0.8rem;
    color: var(--text-dim);
    line-height: 1.45;
  }

  /* law cards */
  .plan-doc .law {
    display: grid;
    gap: 1rem;
    margin: 1.5rem 0;
  }

  .plan-doc .law-card {
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--bg-elev);
    overflow: hidden;
  }

  .plan-doc .law-card .head {
    padding: 0.7rem 1.1rem;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    font-weight: 500;
  }

  .plan-doc .law-card .body {
    padding: 1rem 1.1rem 0.4rem;
    border-top: 1px solid var(--line);
  }

  .plan-doc .law-card ul { max-width: none; }

  .plan-doc .law-req .head { background: rgba(74, 222, 128, 0.12); color: var(--p-good); }
  .plan-doc .law-rec .head { background: rgba(245, 158, 11, 0.12); color: var(--p-warn); }
  .plan-doc .law-no .head { background: rgba(251, 113, 133, 0.12); color: var(--p-bad); }

  /* checklist */
  .plan-doc .checklist {
    counter-reset: step;
    list-style: none;
    padding-left: 0;
    max-width: none;
  }

  .plan-doc .checklist li {
    counter-increment: step;
    display: grid;
    grid-template-columns: 2.4rem 1fr;
    gap: 0.9rem;
    padding: 0.8rem 0;
    margin: 0;
    border-bottom: 1px solid var(--line);
    align-items: baseline;
  }

  .plan-doc .checklist li::before {
    content: counter(step, decimal-leading-zero);
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--p-accent);
  }

  .plan-doc .checklist li:last-child { border-bottom: none; }

  .plan-doc .checklist .when {
    display: block;
    font-family: var(--font-mono);
    font-size: 0.65rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-faint);
    margin-top: 0.2rem;
  }

  /* footer */
  /* video explainers */
  .plan-doc .vids {
    border: 1px solid var(--line);
    border-left: 2px solid var(--p-accent);
    border-radius: 0 var(--radius) var(--radius) 0;
    background: var(--bg-elev);
    padding: 0.95rem 1.15rem 0.55rem;
    margin: 1.5rem 0;
  }

  .plan-doc .vids .vh {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--p-accent);
    margin-bottom: 0.5rem;
  }

  .plan-doc a.vid {
    display: grid;
    grid-template-columns: 1.7rem 1fr;
    column-gap: 0.8rem;
    padding: 0.65rem 0;
    border-top: 1px solid var(--line);
    text-decoration: none;
    color: inherit;
  }

  .plan-doc .vids a.vid:first-of-type { border-top: none; padding-top: 0.15rem; }

  .plan-doc a.vid .play {
    grid-row: 1 / span 2;
    align-self: center;
    width: 1.7rem;
    height: 1.7rem;
    border-radius: 50%;
    border: 1px solid var(--line-strong);
    color: var(--p-accent);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.55rem;
    transition: border-color var(--ease), color var(--ease);
  }

  .plan-doc a.vid .vt {
    font-size: 0.9rem;
    font-weight: 600;
    line-height: 1.35;
  }

  .plan-doc a.vid .vm {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--text-faint);
    line-height: 1.5;
    margin-top: 0.12rem;
  }

  .plan-doc a.vid:hover .vt { color: var(--p-accent); text-decoration: underline; }
  .plan-doc a.vid:hover .play { border-color: var(--p-accent); }

  .plan-doc a.vid:focus-visible {
    outline: 2px solid var(--cyan);
    outline-offset: 2px;
    border-radius: 3px;
  }

  @media (max-width: 34rem) {
    .plan-doc a.vid { grid-template-columns: 1fr; }
    .plan-doc a.vid .play { display: none; }
  }

  .plan-doc .plan-foot {
    margin-top: 4.5rem;
    padding-top: 1.75rem;
    border-top: 1px solid var(--line-strong);
    font-size: 0.8rem;
    color: var(--text-faint);
  }

  .plan-doc .plan-foot p { max-width: 58em; }

  @media (max-width: 34rem) {
    .plan-doc .frow { grid-template-columns: 1fr; }
    .plan-doc .flabel { text-align: left; }
    .plan-doc .fnote { grid-column: 1; }
    .plan-doc .ledger { font-size: 0.72rem; }
  }
</style>

<script>
  /* ---------- Sign in with Google ----------
     The ID token is the only credential. It goes to /api/private-doc as a
     Bearer token, where the function verifies it with Google and checks the
     email against ALLOWED_EMAILS. Nothing here decides who gets in — this page
     just collects the token. Hiding the gate grants nothing, because the
     document is not in the page until the server sends it.

     Tokens last about an hour. When one expires the API answers 401 and the
     gate goes back up, rather than leaving a dead page on screen.
  ------------------------------------------------------------------------- */

  const gate = document.getElementById("gate")!;
  const docWrap = document.getElementById("docWrap")!;
  const doc = document.getElementById("doc")!;
  const status = document.getElementById("status")!;
  const whoamiEmail = document.getElementById("whoamiEmail")!;
  const signOutButton = document.getElementById("signOut")!;
  const buttonHost = document.getElementById("gsiButton")!;

  const slug = docWrap.dataset.slug!;
  const TOKEN_KEY = `private:${slug}:token`;

  let clientId: string | null = null;

  function setStatus(message: string, isError = false) {
    status.textContent = message;
    status.classList.toggle("is-error", isError);
  }

  function setToken(token: string | null) {
    try {
      if (token) sessionStorage.setItem(TOKEN_KEY, token);
      else sessionStorage.removeItem(TOKEN_KEY);
    } catch {
      // A browser with storage blocked still works; it just asks again.
    }
  }

  function readToken() {
    try {
      return sessionStorage.getItem(TOKEN_KEY);
    } catch {
      return null;
    }
  }

  /**
   * Three different failures used to share one message, which sent people
   * looking in the wrong place:
   *   401 with sign-in configured     -> the email really is not allowed
   *   401 with sign-in NOT configured -> nobody can get in; the API refuses
   *      everything because it has no client id to verify tokens against
   *   anything else                   -> the backend is broken or unreachable
   */
  function failureMessage(response: Response, body: { error?: string }) {
    if (response.status === 401) {
      if (!clientId) {
        return "Sign-in is not set up on this site yet, so this document is " +
               "locked for everyone. Set GOOGLE_CLIENT_ID to enable it.";
      }
      return "That account is not on the list for this document.";
    }
    if (response.status === 404) {
      return body.error || "That document is not published yet.";
    }
    return `Signed in, but the document could not load: ${body.error || response.status}. ` +
           "This is a setup problem, not your account.";
  }

  function reveal(html: string, email: string) {
    doc.innerHTML = html;
    whoamiEmail.textContent = email;
    docWrap.hidden = false;
    gate.remove();
    // Take the title from the document itself. Hardcoding it here would ship
    // the private document's name in the public JS bundle.
    const heading = doc.querySelector("h1")?.textContent?.trim();
    if (heading) document.title = `${heading} — private`;
    window.scrollTo(0, 0);
  }

  /** Fetches the document. Returns nothing and puts the gate back on failure. */
  async function load(token: string, { silent = false } = {}) {
    setStatus("Opening…");

    let response: Response;
    try {
      response = await fetch(`/api/private-doc?slug=${encodeURIComponent(slug)}`, {
        headers: { authorization: `Bearer ${token}` },
        cache: "no-store",
      });
    } catch {
      setStatus("Could not reach the site. Check your connection.", true);
      return;
    }

    const body = await response.json().catch(() => ({}));

    if (!response.ok) {
      setToken(null);
      // A silent retry of a stored token that has since expired is not an
      // error worth shouting about; just ask for a fresh sign-in.
      if (silent && response.status === 401) {
        setStatus("Your sign-in expired. Please sign in again.");
        return;
      }
      setStatus(failureMessage(response, body), true);
      return;
    }

    setToken(token);
    reveal(body.html, body.email || "signed in");
  }

  // Called by Google once the person picks an account.
  async function onCredential(response: { credential: string }) {
    await load(response.credential);
  }

  signOutButton.addEventListener("click", () => {
    setToken(null);
    const google = (window as any).google;
    google?.accounts?.id?.disableAutoSelect();
    location.reload();
  });

  async function init() {
    let config: { googleClientId?: string | null } = {};
    try {
      config = await fetch("/api/config", { cache: "no-store" }).then((r) => r.json());
    } catch {
      // Astro's own dev server has no /api routes. Say so rather than
      // rendering a sign-in button that cannot work.
    }
    clientId = config.googleClientId || null;

    if (!clientId) {
      setStatus(
        "Sign-in is not configured here. Run `npx vercel dev` for the API, " +
        "or set GOOGLE_CLIENT_ID in Vercel.",
        true,
      );
      return;
    }

    const google = (window as any).google;
    if (!google?.accounts?.id) {
      setStatus("Google's sign-in script did not load. Check for a blocker.", true);
      return;
    }

    google.accounts.id.initialize({
      client_id: clientId,
      callback: onCredential,
      auto_select: true,
    });
    google.accounts.id.renderButton(buttonHost, {
      theme: "filled_black",
      size: "large",
      text: "signin_with",
      shape: "pill",
    });

    // Survive a refresh mid-read without signing in again.
    const saved = readToken();
    if (saved) await load(saved, { silent: true });
    else setStatus("");
  }

  window.addEventListener("load", init);
</script>
