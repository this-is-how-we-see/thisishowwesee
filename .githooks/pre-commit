#!/bin/sh
#
# Warn when a private document changed on disk but was never published.
#
# The plaintext sources in private/ are gitignored and the documents now live
# in a private Vercel Blob, so git cannot see an edit and a commit cannot carry
# one. That is fine, but it makes "I changed the doc" and "readers can see the
# change" two separate acts. This hook says so rather than letting the edit sit
# on the laptop unnoticed.
#
# This only warns. It never blocks a commit: nothing in the commit depends on
# the blob being current.
#
# Installed via core.hooksPath (set by `npm install`, or manually with:
#   git config core.hooksPath .githooks)

[ -d private ] || exit 0
command -v node >/dev/null 2>&1 || exit 0

node - <<'NODE'
const { readFileSync, existsSync } = require('node:fs');
const { createHash } = require('node:crypto');

const SOURCES = [
  'private/healthcare.src.html',
  'private/health-advocates.src.html',
  'private/budget.src.html',
  'private/aab.src.html',
];

let state = {};
try { state = JSON.parse(readFileSync('private/.publish-state.json', 'utf8')); } catch {}

const stale = SOURCES.filter((source) => {
  if (!existsSync(source)) return false;
  const hash = createHash('sha256').update(readFileSync(source, 'utf8')).digest('hex');
  return state[source] !== hash;
});

if (stale.length) {
  console.error('');
  console.error('  Not published yet:');
  for (const source of stale) console.error(`    ${source}`);
  console.error('');
  console.error('  Readers still see the previous version. Publish with:');
  console.error('    npm run publish-private');
  console.error('');
}
NODE

exit 0
