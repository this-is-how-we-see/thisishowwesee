# Local development for the private-document API. Copy to .env.local.
#
# The quickest way to fill this in is to let Vercel do it:
#
#   npx vercel env pull .env.local --scope howardseay-8349s-projects
#
# .env.local is gitignored. Never commit a real value here — this repo is public.

# OAuth client id for Sign in with Google. Public by design (it appears in the
# sign-in button's markup either way).
#
# This is SHARED with jjkind-site's client, "jjkind-site admin", in Google Cloud
# project `jj-kind`. A dedicated client is cleaner, because a shared client means
# a token minted for jjkind's /manage carries the same `aud` and passes the check
# here. Only ALLOWED_EMAILS separates the two sites. Both sites are Howie's, so
# the exposure stays small.
#
# The client's "Authorized JavaScript origins" must list
# https://thisishowwesee.com and http://localhost:3000. Leave "Authorized
# redirect URIs" empty — Google Identity Services does not use them, and a
# missing origin shows up as "Error 400: origin_mismatch". A client id that names
# a client somebody deleted shows up as "Error 401: deleted_client".
GOOGLE_CLIENT_ID=

# Who may read the private documents. Comma-separated, case-insensitive.
# Removing an address revokes that person on their next request.
ALLOWED_EMAILS=howard.seay@gmail.com,danielle.n.seay@gmail.com

# Vercel Blob. Vercel injects this in deployment; you need it locally only to
# run `npm run publish-private`.
BLOB_READ_WRITE_TOKEN=
